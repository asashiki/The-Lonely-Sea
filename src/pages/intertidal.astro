---
import { getIntertidalPairs, getIntertidalIndex } from "../lib/intertidal";
import { getPublishedPosts } from "../lib/posts";
import TidalConcordance from "../components/TidalConcordance.astro";
import { siteConfig } from "../../site.config.mjs";
import "../styles/intertidal.css";
const posts = await getPublishedPosts();
const [pairs, lexicon] = await Promise.all([getIntertidalPairs(posts), getIntertidalIndex(posts)]);
const first = pairs[0];
const json = JSON.stringify(pairs).replaceAll("<", "\\u003c");
const indexJson = JSON.stringify(lexicon).replaceAll("<", "\\u003c");
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#172b35" />
    <title>潮间带 · {siteConfig.name}</title>
    <meta name="description" content="留住一页，翻开另一年。让不同文章里的文字在同一片海上相遇。" />
    <link rel="canonical" href={new URL("/intertidal/", siteConfig.url)} />
    <link rel="preload" as="image" href="/assets/lonely-sea/night.webp" />
  </head>
  <body>
    <div class="tidal-scene" aria-hidden="true"></div>
    <main class="intertidal" id="intertidal" style="--tide:50%">
      <header class="tidal-header">
        <a href="/?screen=extra" class="tidal-back">← <span>BACK</span></a>
        <p>INTERTIDAL <span>／</span> 两页之间</p>
        <button type="button" data-tide-share>寄出这次相遇 ↗</button>
      </header>
      <div class="tidal-title"><h1>潮间带</h1><p>留住一页，<br />翻开另一年。</p></div>
      <section class="tidal-reading" aria-label="两篇原文对读">
        <header class="tidal-chapter"><span data-tide-number>01</span><h2 data-tide-title>{first?.title || "海水尚未退去"}</h2><button type="button" data-tide-swap aria-label="交换左右两页">左右交换 ⇄</button></header>
        <div class="tidal-spread" data-tide-spread>
          {(["left", "right"] as const).map((side) => {
            const source = first?.[side];
            return <article class="tidal-page" data-tide-side={side}>
              <div class="tidal-page-top"><p><span data-source-year>{source?.year}</span><small>年的记录</small></p><button type="button" data-tide-pin={side} aria-pressed="false">留住这一页</button></div>
              <div class="tidal-text" data-source-scroll tabindex="0" aria-label={side === "left" ? "左页原文" : "右页原文"}>
                <blockquote data-source-quote>{source?.quote}</blockquote>
                <div class="tidal-original" data-source-original hidden></div>
              </div>
              <footer class="tidal-source">
                <p><span data-source-section>{source?.section}</span></p>
                <a data-source-title href={source?.href}>{source?.title}</a>
                <small data-source-date>{source ? `发表于 ${source.published}` : ""}</small>
                <div class="tidal-page-actions"><button type="button" data-tide-expand={side} aria-expanded="false">在这里展开原文</button><button type="button" data-tide-next={side}>另翻一页 →</button></div>
              </footer>
            </article>;
          })}
          <button class="tidal-divider" data-tide-divider type="button" role="separator" aria-orientation="vertical" aria-label="调整两页宽度" aria-valuemin="30" aria-valuemax="70" aria-valuenow="50"><span aria-hidden="true">↔</span></button>
        </div>
        <footer class="tidal-navigation">
          <button class="tidal-turn" type="button" data-tide-previous aria-label="上一组对读">←</button>
          <nav aria-label="对读篇目">{pairs.map((pair, i) => <button type="button" data-tide-pair={pair.id} aria-current={i === 0 ? "page" : undefined}>{pair.title}</button>)}</nav>
          <button class="tidal-turn" type="button" data-tide-following aria-label="下一组对读">→</button>
        </footer>
      </section>
      <footer class="tidal-footer"><p>摘自已公开文章 · 不同年份，同一片海</p><p data-tide-status role="status" aria-live="polite">拖动中缝，给想读的那一页多留一些空间。</p><button type="button" data-tide-search>循词</button><button type="button" data-tide-random>随潮翻开</button></footer>
      <noscript><p class="tidal-noscript">点击文章标题即可阅读原文。启用 JavaScript 后可以翻页、保留一侧并展开双篇全文。</p></noscript>
    </main>
    <script id="intertidal-data" type="application/json" set:html={json} is:inline></script>
    <script id="intertidal-index" type="application/json" set:html={indexJson} is:inline></script>
    <TidalConcordance />
    <script>import "../scripts/intertidal";</script>
  </body>
</html>
