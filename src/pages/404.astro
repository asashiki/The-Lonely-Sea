---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../../site.config.mjs";
---

<BaseLayout title="页面未找到" description="请求的路线不存在。" noindex>
  <main class="lost-route">
    <div class="lost-route-scene" aria-hidden="true"></div>
    <p class="lost-route-number" aria-hidden="true">404</p>
    <header>
      <span>ROUTE NOT FOUND</span>
      <strong>{siteConfig.latinName}</strong>
    </header>

    <figure aria-hidden="true">
      <img src="/assets/lonely-sea/alice_chibi_transparent.png" alt="">
    </figure>

    <section class="lost-route-dialog" aria-labelledby="lost-route-title">
      <p class="lost-route-speaker">SYSTEM</p>
      <div>
        <small>RECORD ERROR / 404</small>
        <h1 id="lost-route-title">这条路线没有留下记录。</h1>
        <p>地址可能已经改变，也可能从一开始就没有被写进故事。可以返回标题画面，或直接打开读取页。</p>
      </div>
      <nav aria-label="404 页面操作">
        <a href="/"><strong>TITLE</strong><small>RETURN TO TITLE</small></a>
        <a href="/?screen=load"><strong>LOAD</strong><small>OPEN RECORDS</small></a>
      </nav>
    </section>
  </main>
</BaseLayout>

<style>
  :global(:root) {
    color-scheme: dark;
    background: #060d16;
  }

  :global(body) {
    overflow: hidden;
    background: #060d16;
  }

  .lost-route {
    --lost-ink: #e4edf2;
    --lost-soft: rgb(218 231 238 / 64%);
    --lost-faint: rgb(210 226 234 / 39%);
    --lost-accent: #719bb9;

    position: relative;
    min-block-size: 100vh;
    min-block-size: 100svh;
    overflow: hidden;
    color: var(--lost-ink);
    background: #071019;
    isolation: isolate;
  }

  .lost-route-scene {
    position: absolute;
    z-index: -2;
    inset: 0;
    background:
      linear-gradient(180deg, rgb(2 8 16 / 32%), rgb(2 8 16 / 72%)),
      radial-gradient(circle at 76% 36%, rgb(101 154 190 / 18%), transparent 31rem),
      url("/assets/lonely-sea/night.png") center / cover no-repeat;
    transform: scale(1.02);
  }

  .lost-route-scene::after {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(0 6 12 / 42%), transparent 35%, transparent 76%, rgb(0 6 12 / 24%)),
      repeating-linear-gradient(0deg, rgb(215 232 241 / 1.5%) 0 1px, transparent 1px 4px);
    content: "";
  }

  .lost-route > header {
    position: absolute;
    z-index: 4;
    top: clamp(1.5rem, 5vh, 3.8rem);
    left: clamp(1.5rem, 5vw, 5rem);
    display: grid;
    gap: .7rem;
  }

  .lost-route > header span {
    color: var(--lost-faint);
    font: 600 .62rem / 1 "Yu Gothic", sans-serif;
    letter-spacing: .22em;
  }

  .lost-route > header strong {
    font: 400 clamp(1.2rem, 2vw, 2rem) / 1 Baskerville, serif;
    letter-spacing: .14em;
  }

  .lost-route-number {
    position: absolute;
    z-index: 0;
    top: -8vh;
    right: -1vw;
    margin: 0;
    color: rgb(174 205 222 / 10%);
    font: italic 400 clamp(12rem, 35vw, 34rem) / .8 Baskerville, serif;
    letter-spacing: -.09em;
    pointer-events: none;
  }

  .lost-route figure {
    position: absolute;
    z-index: 1;
    right: clamp(2rem, 9vw, 10rem);
    bottom: 19vh;
    width: min(33rem, 46vw);
    height: min(68vh, 42rem);
    margin: 0;
    filter: drop-shadow(0 2rem 3rem rgb(0 0 0 / 48%));
  }

  .lost-route figure::before {
    position: absolute;
    inset: 34% 4% 2%;
    border-radius: 50%;
    background: rgb(91 146 181 / 16%);
    box-shadow: 0 0 5rem rgb(79 139 177 / 18%);
    content: "";
    filter: blur(1.2rem);
  }

  .lost-route figure img {
    position: relative;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: bottom center;
  }

  .lost-route-dialog {
    position: absolute;
    z-index: 6;
    right: clamp(1.3rem, 4vw, 4rem);
    bottom: clamp(1.3rem, 4vh, 3rem);
    left: clamp(1.3rem, 4vw, 4rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(19rem, .48fr);
    gap: clamp(2rem, 5vw, 5rem);
    min-height: 13rem;
    padding: clamp(2rem, 4vh, 3rem) clamp(1.5rem, 4vw, 4rem);
    color: #27353e;
    background: rgb(237 241 240 / 92%);
    box-shadow:
      inset 0 1px rgb(255 255 255 / 52%),
      0 1.5rem 4rem rgb(0 4 8 / 48%);
    backdrop-filter: blur(16px);
  }

  .lost-route-speaker {
    position: absolute;
    top: -2.6rem;
    left: clamp(1.5rem, 4vw, 4rem);
    min-width: 9rem;
    margin: 0;
    padding: .9rem 1.3rem;
    color: #edf4f7;
    background: rgb(6 18 29 / 88%);
    box-shadow: 0 .4rem 1rem rgb(0 0 0 / 25%);
    font: 500 .72rem / 1 Baskerville, serif;
    letter-spacing: .17em;
  }

  .lost-route-dialog > div {
    align-self: center;
  }

  .lost-route-dialog small {
    color: #7b8991;
    font: 600 .6rem / 1 "Yu Gothic", sans-serif;
    letter-spacing: .17em;
  }

  .lost-route-dialog h1 {
    margin: .8rem 0 0;
    font: 500 clamp(1.65rem, 3vw, 3rem) / 1.2 "Yu Mincho", serif;
    letter-spacing: .06em;
  }

  .lost-route-dialog > div > p {
    max-width: 42rem;
    margin: 1rem 0 0;
    color: #62717a;
    font: 400 clamp(.85rem, 1.3vw, 1rem) / 1.75 "Yu Mincho", serif;
  }

  .lost-route-dialog nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-self: center;
    gap: .8rem;
  }

  .lost-route-dialog nav a {
    display: grid;
    align-content: center;
    justify-items: start;
    min-height: 5.8rem;
    padding: 1rem 1.2rem;
    border: 1px solid rgb(63 91 108 / 34%);
    color: #43535d;
    background:
      linear-gradient(115deg, rgb(255 255 255 / 32%), transparent 46%),
      rgb(92 131 155 / 7%);
    box-shadow:
      inset 0 1px rgb(255 255 255 / 48%),
      0 .4rem .9rem rgb(36 53 63 / 10%);
    text-decoration: none;
    transform: translate3d(0, 0, 0);
    transition:
      color 180ms ease,
      border-color 180ms ease,
      background-color 180ms ease,
      transform 220ms cubic-bezier(.22, 1, .36, 1);
  }

  .lost-route-dialog nav strong {
    font: 400 1.1rem / 1 Baskerville, serif;
    letter-spacing: .15em;
  }

  .lost-route-dialog nav small {
    margin-top: .7rem;
    font-size: .52rem;
  }

  @media (hover: hover) and (pointer: fine) {
    .lost-route-dialog nav a:hover,
    .lost-route-dialog nav a:focus-visible {
      border-color: rgb(69 119 149 / 68%);
      color: #263944;
      background-color: rgb(83 132 163 / 14%);
      transform: translate3d(0, -2px, 0);
    }
  }

  @media (max-width: 46rem) {
    .lost-route figure {
      right: -8vw;
      bottom: 31vh;
      width: 66vw;
      height: 48vh;
      opacity: .72;
    }

    .lost-route-dialog {
      grid-template-columns: 1fr;
      gap: 1.3rem;
      padding: 2.2rem 1.3rem 1.3rem;
    }

    .lost-route-dialog nav {
      gap: .55rem;
    }

    .lost-route-dialog nav a {
      min-height: 4.7rem;
      padding: .8rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lost-route-dialog nav a {
      transition: none;
      transform: none;
    }
  }
</style>
