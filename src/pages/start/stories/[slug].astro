---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getPublishedPosts, postHref, postSlug } from "../../../lib/posts";
import { listRegisteredGames, type RegisteredGame } from "../../../lib/gal-blog/release-registry";

export function getStaticPaths() {
  return listRegisteredGames().map((game) => ({
    params: { slug: game.slug },
    props: { game },
  }));
}

interface Props {
  game: RegisteredGame;
}

const { game } = Astro.props;
const articles = (await getPublishedPosts()).map((post) => ({
  slug: postSlug(post),
  path: postHref(post),
}));
const configJson = JSON.stringify({ game, articles }).replaceAll("<", "\\u003c");
---

<BaseLayout title={game.title} description={`${game.title}的游戏宿主页。`} noindex>
  <main class="game-host" data-gal-blog-host data-host-state="loading">
    <header class="game-host__bar">
      <a href="/?screen=load">RETURN</a>
      <p><span>STORY</span><strong>{game.title}</strong></p>
      <div>
        <button type="button" data-host-reload>RELOAD</button>
        <button type="button" data-host-fullscreen>FULL SCREEN</button>
      </div>
    </header>

    <section class="game-host__stage" aria-label={`${game.title}游戏画面`}>
      <iframe
        data-game-frame
        title={game.title}
        sandbox="allow-scripts allow-same-origin allow-forms allow-pointer-lock"
        allow="autoplay; fullscreen"
        allowfullscreen
        hidden
      ></iframe>
      <div class="game-host__status" data-host-status role="status">
        <span aria-hidden="true"></span>
        <p data-host-status-message>PREPARING GAME HOST</p>
      </div>
    </section>

    <footer>
      <span>GAL-BLOG BRIDGE / V1</span>
      <span>{game.currentReleaseId ?? "PACKAGE PENDING"}</span>
    </footer>
    <script id="gal-blog-host-config" type="application/json" set:html={configJson} is:inline></script>
  </main>

  <script>
    import "../../../scripts/experience/gal-blog-host-page";
  </script>
</BaseLayout>

<style>
  .game-host {
    --host-line: rgb(213 226 231 / 28%);
    --host-soft: rgb(222 235 239 / 64%);
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    min-block-size: 100vh;
    min-block-size: 100svh;
    padding: clamp(0.85rem, 2vw, 1.6rem);
    overflow: hidden;
    background:
      linear-gradient(115deg, rgb(113 140 151 / 10%), transparent 42%),
      #070d12;
  }

  .game-host__bar,
  .game-host > footer {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-block-size: 3.2rem;
    color: var(--host-soft);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.16em;
  }

  .game-host__bar a,
  .game-host__bar button {
    border: 0;
    color: inherit;
    background: transparent;
    text-decoration: none;
  }

  .game-host__bar p {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
  }

  .game-host__bar p span {
    color: rgb(222 235 239 / 38%);
  }

  .game-host__bar p strong {
    color: #e8f0f2;
    font-family: var(--font-display);
    font-size: 0.88rem;
    font-weight: 400;
    letter-spacing: 0.1em;
  }

  .game-host__bar > div {
    display: flex;
    justify-content: flex-end;
    gap: 1.2rem;
  }

  .game-host__stage {
    position: relative;
    min-block-size: 0;
    overflow: hidden;
    border-block: 1px solid var(--host-line);
    background:
      radial-gradient(circle at 50% 36%, rgb(114 143 154 / 20%), transparent 42%),
      rgb(4 9 13 / 88%);
  }

  .game-host__stage iframe {
    inline-size: 100%;
    block-size: 100%;
    border: 0;
    background: #000;
  }

  .game-host__status {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 1.1rem;
    color: var(--host-soft);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-align: center;
  }

  .game-host__status[hidden] {
    display: none;
  }

  .game-host__status span {
    inline-size: min(14rem, 44vw);
    block-size: 1px;
    background: linear-gradient(90deg, transparent, rgb(213 226 231 / 72%), transparent);
    animation: host-wait 1.8s ease-in-out infinite alternate;
  }

  .game-host[data-host-state="error"] .game-host__status,
  .game-host[data-host-state="unavailable"] .game-host__status {
    color: rgb(231 211 205 / 72%);
  }

  .game-host > footer {
    grid-template-columns: 1fr 1fr;
    min-block-size: 2.5rem;
    color: rgb(222 235 239 / 34%);
  }

  .game-host > footer span:last-child {
    text-align: end;
  }

  @keyframes host-wait {
    from { opacity: 0.28; transform: scaleX(0.5); }
    to { opacity: 0.86; transform: scaleX(1); }
  }

  @media (max-width: 42rem) {
    .game-host__bar {
      grid-template-columns: auto 1fr;
    }

    .game-host__bar p {
      justify-self: end;
    }

    .game-host__bar > div {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .game-host__status span { animation: none; }
  }
</style>
