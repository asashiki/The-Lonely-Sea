---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import LoadTracksXiiiConcept from "../../../components/experience/LoadTracksXiiiConcept.astro";
import OptionScreen from "../../../components/experience/OptionScreen.astro";
import BlogInteractionScene from "../../../components/experience/BlogInteractionScene.astro";
import { publishedFriends } from "../../../data/communication";
import { getExperienceRecords } from "../../../lib/experience-records";
import { getPublishedPosts, postHref, postSlug } from "../../../lib/posts";
import { listRegisteredGames, type RegisteredGame } from "../../../lib/gal-blog/release-registry";
import { siteConfig } from "../../../../site.config.mjs";
import "../../../styles/experience.css";
import "../../../styles/special-system-pages.css";
import "../../../styles/option-refinement.css";
import "../../../styles/load-tracks-xiii.css";
import "../../../styles/blog-interaction-scene.css";
import "../../../styles/blog-interaction-bridge.css";

export function getStaticPaths() {
  return listRegisteredGames().map((game) => ({
    params: { slug: game.slug },
    props: { game },
  }));
}

interface Props {
  game: RegisteredGame;
}

const { game } = Astro.props;
const currentRelease = game.releases.find((release) => release.releaseId === game.currentReleaseId);
const loaderArtUrl = currentRelease?.manifest.presentation?.loaderArt
  ? `${currentRelease.packageUrl}/${currentRelease.manifest.presentation.loaderArt}`
  : "/assets/lonely-sea/characters/alice/idle.png";
const publishedPosts = await getPublishedPosts();
const articles = publishedPosts.map((post) => ({
  slug: postSlug(post),
  path: postHref(post),
}));
const rssItems = publishedPosts.slice(0, 6).map((post) => ({
  title: post.data.title,
  href: postHref(post),
  date: post.data.published.toISOString().slice(0, 10),
  description: post.data.description,
}));
const rssUrl = new URL("/rss.xml", siteConfig.url).href;
const records = await getExperienceRecords();
const configJson = JSON.stringify({ game, articles }).replaceAll("<", "\\u003c");
---

<BaseLayout title={game.title} description={`${game.title}的游戏宿主页。`} noindex>
  <main class="game-host" data-gal-blog-host data-host-state="loading">
    <section class="game-host__stage" aria-label={`${game.title}游戏画面`}>
      <iframe
        data-game-frame
        title={game.title}
        sandbox="allow-scripts allow-same-origin allow-forms allow-pointer-lock"
        allow="autoplay; fullscreen"
        allowfullscreen
        hidden
      ></iframe>
      <div class="game-host__status" data-host-status role="status">
        <span class="game-host__status-art" aria-hidden="true" style={`--game-loader-art: url("${loaderArtUrl}")`}></span>
        <div>
          <small>{siteConfig.latinName} / STORY</small>
          <h1>{game.title}</h1>
          <p data-host-status-message>正在载入故事……</p>
          <i aria-hidden="true"></i>
          <a data-host-error-return href="/" hidden>RETURN</a>
        </div>
      </div>
    </section>
    <section class="game-host-load system-screen" data-host-load aria-hidden="true" hidden>
      <div class="route-curtain" id="route-curtain" aria-hidden="true">
        <span aria-hidden="true"></span>
        <p><small>{siteConfig.latinName}</small><strong>NOW LOADING</strong></p>
      </div>
      <LoadTracksXiiiConcept records={records} />
    </section>
    <script id="gal-blog-host-config" type="application/json" set:html={configJson} is:inline></script>
  </main>

  <OptionScreen />

  <dialog class="blog-interaction-modal" data-host-comment-dialog aria-label="游戏内访客留言">
    <BlogInteractionScene
      contextKey={`game:${game.slug}`}
      variant="bridge"
      title="留下这段话"
      prompt="这句话会交还给当前故事，并保存在这台设备中。"
      includeFriends={true}
      includeRss={true}
      rssUrl={rssUrl}
      rssItems={rssItems}
      friends={publishedFriends}
    />
  </dialog>

  <script>
    import "../../../scripts/experience/gal-blog-host-page";
  </script>
</BaseLayout>

<style>
  .game-host {
    --host-line: rgb(213 226 231 / 32%);
    --host-soft: rgb(230 240 243 / 72%);
    min-block-size: 100vh;
    min-block-size: 100svh;
    overflow: hidden;
    background: #05090d;
  }

  .game-host__stage {
    position: relative;
    inline-size: 100vw;
    block-size: 100vh;
    block-size: 100svh;
    overflow: hidden;
    background: #05090d;
  }

  .game-host__stage iframe {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    border: 0;
    background: #000;
    opacity: 0;
    transition: opacity 320ms ease;
  }

  .game-host[data-host-state="ready"] .game-host__stage iframe {
    opacity: 1;
  }

  .game-host__status {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(22rem, 40vw);
    align-items: stretch;
    color: var(--host-soft);
    background:
      linear-gradient(90deg, rgb(4 9 13 / 18%), rgb(4 9 13 / 78%) 66%),
      url("/assets/lonely-sea/night.png") center / cover;
  }

  .game-host__status {
    transition: opacity 280ms ease, visibility 280ms step-end;
  }

  .game-host[data-host-state="ready"] .game-host__status {
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
  }

  .game-host__status-art {
    align-self: end;
    justify-self: center;
    inline-size: min(55vw, 44rem);
    block-size: 88%;
    background: var(--game-loader-art) center bottom / contain no-repeat;
    filter: drop-shadow(0 1.5rem 2.5rem rgb(0 0 0 / 30%));
  }

  .game-host__status > div {
    align-self: center;
    padding: clamp(2rem, 6vw, 7rem);
  }

  .game-host__status small {
    font: 600 clamp(.58rem, .7vw, .72rem) / 1.2 var(--font-sans);
    letter-spacing: .28em;
  }

  .game-host__status h1 {
    max-inline-size: 12em;
    margin: 1.2rem 0 .65rem;
    color: #eef5f6;
    font: 400 clamp(2rem, 4vw, 4.5rem) / 1.08 var(--font-display);
    letter-spacing: .09em;
  }

  .game-host__status p {
    margin: 0;
    font: 500 clamp(.68rem, .85vw, .9rem) / 1.7 var(--font-sans);
    letter-spacing: .14em;
  }

  .game-host[data-host-state="error"] .game-host__status,
  .game-host[data-host-state="unavailable"] .game-host__status {
    color: rgb(231 211 205 / 72%);
  }

  .game-host__status i {
    display: block;
    inline-size: 2.8rem;
    block-size: 2.8rem;
    margin-block-start: 1.5rem;
    border-radius: 50%;
    background: radial-gradient(circle,rgb(190 224 235 / 32%) 0 9%,transparent 10%);
    box-shadow: 0 0 0 1px rgb(190 224 235 / 18%);
    animation: host-wait 1.6s ease-in-out infinite alternate;
  }

  .game-host__status a {
    display: inline-block;
    margin-block-start: 1.5rem;
    border-block-end: 1px solid currentColor;
    padding-block-end: .3rem;
    color: inherit;
    font: 600 .68rem / 1 var(--font-sans);
    letter-spacing: .24em;
    text-decoration: none;
  }

  .game-host__status a[hidden] { display: none; }

  @keyframes host-wait {
    from { opacity: 0.28; transform: scale(.76); }
    to { opacity: 0.86; transform: scale(1.08); }
  }

  @media (max-width: 42rem) {
    .game-host__status { grid-template-columns: 1fr; }
    .game-host__status-art { position: absolute; inset: auto 0 0; inline-size: 100%; block-size: 78%; opacity: .58; }
    .game-host__status > div { position: relative; z-index: 1; align-self: end; padding: 2rem 1.5rem 3rem; background: linear-gradient(transparent, rgb(4 9 13 / 84%) 24%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .game-host__status i { animation: none; }
    .game-host__stage iframe,
    .game-host__status { transition: none; }
  }

  .game-host-load {
    position: fixed;
    z-index: 800;
    inset: 0;
    background: #05090d;
  }

  .game-host-load[hidden] { display: none; }

  .game-host-load :global(.load-tracks-xiii-canvas) { display: grid; }

  .game-host-load :global(.tracks-xiii-primary-shell),
  .game-host-load :global(.tracks-xiii-index) {
    display: none;
  }

  .game-host-load :global(.tracks-xiii-stage) {
    top: 15cqh;
    bottom: 11cqh;
    grid-template-columns: minmax(0, 1fr);
  }

  .game-host-load :global(.tracks-xiii-heading)::after {
    display: block;
    margin-block-start: .35rem;
    color: rgb(222 235 239 / 58%);
    content: "SAVE DATA · LOAD";
    font: 600 clamp(.56rem, .68vw, .72rem) / 1 var(--font-sans);
    letter-spacing: .22em;
  }

  .game-host-load[data-save-operation="save"] :global(.tracks-xiii-heading)::after {
    content: "SAVE DATA · SAVE";
  }

  .game-host-load :global(.tracks-xiii-view-ghost) {
    inset-inline-start: 0;
  }

  .game-host-load :global(.tracks-xiii-panel[data-xiii-panel="articles"]),
  .game-host-load :global(.tracks-xiii-panel[data-xiii-panel="diary"]),
  .game-host-load :global([data-xiii-game-view="flow"]),
  .game-host-load :global([data-xiii-game-view="story"]) {
    display: none !important;
  }

  .game-host-dialog {
    width: min(52rem, calc(100vw - 2rem));
    max-height: calc(100svh - 2rem);
    padding: 0;
    border: 1px solid rgb(213 226 231 / 32%);
    color: #e8f0f2;
    background:
      linear-gradient(135deg, rgb(113 140 151 / 13%), transparent 45%),
      rgb(7 15 21 / 96%);
    box-shadow: 0 2rem 7rem rgb(0 0 0 / 72%);
  }

  .game-host-dialog::backdrop {
    background: rgb(2 7 11 / 72%);
    backdrop-filter: blur(12px);
  }

  .game-host-dialog form {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem 1.6rem;
    padding: clamp(1.35rem, 4vw, 2.2rem);
  }

  .game-host-dialog header,
  .game-host-dialog form > small,
  .game-host-dialog footer { grid-column: 1 / -1; }
  .game-host-dialog header { margin-block-end: .5rem; }
  .game-host-dialog header span,
  .game-host-dialog label > span,
  .game-host-dialog form > small {
    color: rgb(222 235 239 / 46%);
    font: 600 .62rem/1.4 var(--font-sans);
    letter-spacing: .16em;
  }

  .game-host-dialog h2 {
    margin: .7rem 0 0;
    font: 400 clamp(1.4rem, 4vw, 2rem)/1.2 var(--font-display);
    letter-spacing: .08em;
  }

  .game-host-dialog header p {
    margin: .8rem 0 0;
    color: rgb(222 235 239 / 62%);
    line-height: 1.7;
  }

  .game-host-dialog label { display: grid; gap: .55rem; }
  .game-host-dialog label > span { display: grid; gap: .2rem; }
  .game-host-dialog label b { color: #e8f0f2; font: 400 .86rem/1.2 var(--font-display); }
  .game-host-dialog label small { color: rgb(222 235 239 / 40%); }

  .game-host-dialog input[type="text"],
  .game-host-dialog textarea {
    width: 100%;
    border: 0;
    border-bottom: 1px solid rgb(213 226 231 / 28%);
    border-radius: 0;
    color: #f0f5f6;
    background: rgb(255 255 255 / 4%);
    font: inherit;
  }

  .game-host-dialog input[type="text"] { min-height: 2.7rem; padding-inline: .75rem; }
  .game-host-dialog textarea { padding: .75rem; resize: vertical; }
  .game-host-dialog input[type="range"] { width: 100%; accent-color: #8faeb9; }

  .game-host-dialog .host-setting-toggle {
    grid-template-columns: 1fr auto;
    align-items: center;
  }

  .game-host-dialog .host-setting-toggle input { width: 1.15rem; height: 1.15rem; accent-color: #8faeb9; }
  .game-host-dialog footer { display: flex; justify-content: flex-end; gap: 1rem; margin-block-start: .6rem; }
  .game-host-dialog footer button {
    min-height: 2.65rem;
    padding-inline: 1rem;
    border: 1px solid rgb(213 226 231 / 24%);
    color: rgb(232 240 242 / 72%);
    background: transparent;
    font: 600 .62rem/1 var(--font-sans);
    letter-spacing: .14em;
  }
  .game-host-dialog footer button[type="submit"] { border-color: rgb(143 174 185 / 68%); color: #eef5f6; }

  @media (max-width: 38rem) {
    .game-host-dialog form { grid-template-columns: 1fr; max-height: calc(100svh - 2rem); overflow: auto; }
    .game-host-dialog header,
    .game-host-dialog form > small,
    .game-host-dialog footer { grid-column: auto; }
  }
</style>
