---
import { getCollection, type CollectionEntry } from "astro:content";
import ReadingArticle from "../../components/ReadingArticle.astro";
import SiteDiscovery from "../../components/SiteDiscovery.astro";
import { siteConfig } from "../../../site.config.mjs";
import {
  getPublishedPosts,
  postHref,
  postSlug,
} from "../../lib/posts";

export async function getStaticPaths() {
  const posts = import.meta.env.DEV
    ? await getCollection("posts")
    : await getPublishedPosts();

  return posts.map((post) => ({
    params: { slug: postSlug(post) },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;
const { data } = post;
const posts = await getPublishedPosts();
const postIndex = posts.findIndex((entry) => entry.id === post.id);
const olderPost = posts[postIndex + 1];
const href = postHref(post);
---

<title>{data.title} | {siteConfig.name}</title>
<link rel="canonical" href={new URL(href, siteConfig.url)} />
<meta name="description" content={data.description} />
<SiteDiscovery title={`${data.title} | ${siteConfig.name}`} description={data.description} pathname={href} />
<div class="reading-system" data-reading-record={String(Math.max(1, postIndex + 1)).padStart(2, "0")}>
  <ReadingArticle post={post} posts={posts} />

  <aside class="reading-menu"><nav aria-label="阅读指令">
    <a href="/" data-reading-transition>TITLE</a>
    <button type="button" data-reading-auto aria-pressed="false">AUTO</button>
    {olderPost ? <a href={postHref(olderPost)} data-reading-transition>SKIP</a> : <span aria-disabled="true">SKIP</span>}
    <button type="button" data-reading-system-open="load">LOAD</button>
    <button type="button" data-reading-system-open="option">OPTION</button>
    <button type="button" data-reading-menu-close>HIDE</button>
  </nav></aside>
</div>
