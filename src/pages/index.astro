---
import ExitDialog from "../components/experience/ExitDialog.astro";
import ExtraScreen from "../components/experience/ExtraScreen.astro";
import LoadScreen from "../components/experience/LoadScreen.astro";
import OpeningSequence from "../components/experience/OpeningSequence.astro";
import OptionScreen from "../components/experience/OptionScreen.astro";
import StartScreen from "../components/experience/StartScreen.astro";
import TitleStage from "../components/experience/TitleStage.astro";
import ListenDock from "../components/experience/ListenDock.astro";
import NvlReaderModal from "../components/experience/NvlReaderModal.astro";
import { getExperienceRecords } from "../lib/experience-records";
import "../styles/experience.css";
import "../styles/cursor.css";
import "../styles/special-system-pages.css";
import "../styles/extra-refinement.css";
import "../styles/option-refinement.css";
import "../styles/sound-laboratory.css";
import "../styles/load-tracks-xiii.css";
import "../styles/extra-live-data.css";
import "../styles/listen-dock.css";
import "../styles/ambient-dock.css";
import "../styles/achievement-toast.css";
import "../styles/system-navigation.css";
import { siteConfig } from "../../site.config.mjs";

const canonicalUrl = new URL(Astro.url.pathname, siteConfig.url);
const records = await getExperienceRecords();
---

<!doctype html>
<!-- V4 视觉金标准迁移：体验组件的 DOM 与层叠顺序均经过视觉回归。 -->
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#bfc4cb">
  <meta name="description" content={siteConfig.description}>
  <link rel="canonical" href={canonicalUrl}>
  <link rel="alternate" type="application/rss+xml" title={`${siteConfig.name} RSS`} href="/rss.xml">
  <title>{siteConfig.name}</title>
  <link rel="preload" as="image" href="/assets/lonely-sea/mist.png">
  <script is:inline>
    try {
      const value = JSON.parse(localStorage.getItem("lonely-sea-preferences-v2") || "{}");
      document.documentElement.classList.toggle("has-special-cursor", value.specialCursor !== false);
      document.documentElement.dataset.weatherLayer = value.weatherLayer === "OVERLAY" ? "overlay" : "inside";
      document.documentElement.dataset.mobileLandscape = String(value.mobileLandscape !== false);
      const phonePortrait = window.matchMedia("(max-width: 900px) and (orientation: portrait)").matches;
      if (value.mobileLandscape !== false && phonePortrait) {
        document.documentElement.dataset.forcedLandscape = "true";
        document.documentElement.style.setProperty("--forced-stage-width", `${window.innerHeight}px`);
        document.documentElement.style.setProperty("--forced-stage-height", `${window.innerWidth}px`);
      }
    } catch {
      document.documentElement.classList.add("has-special-cursor");
    }
  </script>
</head>
<body data-scene="mist" data-weather="snow" data-route="title">
  <OpeningSequence />
  <div class="route-curtain" id="route-curtain" aria-hidden="true">
    <span aria-hidden="true"></span>
    <p><small>{siteConfig.latinName}</small><strong>NOW LOADING</strong></p>
  </div>

  <main class="stage" aria-label={`${siteConfig.name}现代 Galgame 交互界面`}>
    <TitleStage />
    <StartScreen records={records} />
    <LoadScreen records={records} />
    <ExtraScreen />
    <OptionScreen />
  </main>

  <section class="first-language" data-first-language-gate aria-hidden="true" hidden>
    <div class="first-language__copy">
      <h2>LANGUAGE</h2>
      <div role="radiogroup" aria-label="Language">
        <button type="button" role="radio" data-first-language="ZH-CN" aria-checked="false"><b>简体中文</b></button>
        <button type="button" role="radio" data-first-language="EN-US" aria-checked="false"><b>English</b></button>
        <button type="button" role="radio" data-first-language="JA-JP" aria-checked="false"><b>日本語</b></button>
      </div>
      <button type="button" class="first-language__fullscreen" data-first-fullscreen aria-pressed="false">全屏显示</button>
    </div>
  </section>

  <section class="game-shell" data-game-shell aria-hidden="true" hidden>
    <iframe data-game-shell-frame title="STORY" allow="autoplay; fullscreen" allowfullscreen></iframe>
  </section>

  <ListenDock />

  <ExitDialog />

  <NvlReaderModal />

  <script>
    import "../scripts/experience.js";
  </script>
</body>
</html>
