---
import ExitDialog from "../components/experience/ExitDialog.astro";
import ExtraScreen from "../components/experience/ExtraScreen.astro";
import LoadScreen from "../components/experience/LoadScreen.astro";
import OpeningSequence from "../components/experience/OpeningSequence.astro";
import OptionScreen from "../components/experience/OptionScreen.astro";
import StartScreen from "../components/experience/StartScreen.astro";
import TitleStage from "../components/experience/TitleStage.astro";
import { getExperienceRecords } from "../lib/experience-records";
import "../styles/experience.css";
import "../styles/cursor.css";
import "../styles/special-system-pages.css";
import "../styles/extra-refinement.css";
import "../styles/option-refinement.css";
import "../styles/extra-live-data.css";
import "../styles/achievement-toast.css";
import { siteConfig } from "../../site.config.mjs";

const canonicalUrl = new URL(Astro.url.pathname, siteConfig.url);
const records = await getExperienceRecords();
---

<!doctype html>
<!-- V4 视觉金标准迁移：体验组件的 DOM 与层叠顺序均经过视觉回归。 -->
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#bfc4cb">
  <meta name="description" content={siteConfig.description}>
  <link rel="canonical" href={canonicalUrl}>
  <link rel="alternate" type="application/rss+xml" title={`${siteConfig.name} RSS`} href="/rss.xml">
  <title>{siteConfig.name}</title>
  <link rel="preload" as="image" href="/assets/lonely-sea/mist.png">
  <script is:inline>
    try {
      const value = JSON.parse(localStorage.getItem("lonely-sea-preferences-v2") || "{}");
      document.documentElement.classList.toggle("has-special-cursor", value.specialCursor !== false);
    } catch {
      document.documentElement.classList.add("has-special-cursor");
    }
  </script>
</head>
<body data-scene="mist" data-weather="snow" data-route="title">
  <OpeningSequence />
  <div class="route-curtain" id="route-curtain" aria-hidden="true">
    <span aria-hidden="true"></span>
    <p><small>{siteConfig.latinName}</small><strong>NOW LOADING</strong></p>
  </div>

  <main class="stage" aria-label={`${siteConfig.name}现代 Galgame 交互界面`}>
    <TitleStage />
    <StartScreen records={records} />
    <LoadScreen records={records} />
    <ExtraScreen />
    <OptionScreen />
  </main>

  <section class="first-language" data-first-language-gate aria-hidden="true" hidden>
    <div class="first-language__copy">
      <small>FIRST START / LANGUAGE</small>
      <h2>选择语言</h2>
      <p>此项会同时用于 Blog 与游戏，也可以稍后在 OPTION 中修改。</p>
      <div role="radiogroup" aria-label="首次启动语言">
        <button type="button" data-first-language="ZH-CN"><b>简体中文</b><span>CHINESE</span></button>
        <button type="button" data-first-language="EN-US"><b>English</b><span>ENGLISH</span></button>
        <button type="button" data-first-language="JA-JP"><b>日本語</b><span>JAPANESE</span></button>
      </div>
    </div>
  </section>

  <aside class="listen-dock" id="listen-dock" hidden aria-hidden="true">
    <button type="button" data-listen-toggle aria-pressed="false" aria-label="Play playlist">
      <span class="listen-dock-glyph" aria-hidden="true"></span>
    </button>
    <p>
      <strong data-listen-title></strong>
      <small data-listen-artist></small>
    </p>
    <button type="button" data-listen-next aria-label="Next track">›</button>
    <button type="button" data-listen-stop aria-label="Stop playlist">×</button>
  </aside>

  <ExitDialog />

  <script>
    import "../scripts/experience.js";
  </script>
</body>
</html>
