---
import { Image } from "astro:assets";
import { type CollectionEntry, render } from "astro:content";
import { siteConfig } from "../../../site.config.mjs";
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogInteractionScene from "../../components/experience/BlogInteractionScene.astro";
import { getExperienceRecords } from "../../lib/experience-records";
import {
  formatPostDate,
  getPublishedPosts,
  normalizePostLocale,
  postHref,
  postSlug,
} from "../../lib/posts";
import "../../styles/markdown.css";
import "../../styles/reading-page.css";
import "../../styles/blog-interaction-scene.css";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();

  return posts.map((post) => ({
    params: { slug: postSlug(post) },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;
const { data } = post;
const { Content, headings } = await render(post);
const posts = await getPublishedPosts();
const records = await getExperienceRecords();
const postIndex = posts.findIndex((entry) => entry.id === post.id);
const currentRecord = records[postIndex] ?? records[0];
const olderPost = posts[postIndex + 1];
const newerPost = posts[postIndex - 1];
const olderRecord = records[postIndex + 1];
const newerRecord = records[postIndex - 1];
const tableOfContents = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const hasTableOfContents = tableOfContents.length >= 3;
const readingScene = currentRecord?.scene ?? "mist";
const sceneArt = `/assets/lonely-sea/${readingScene}.png`;
const sceneLabels: Record<string, string> = {
  mist: "MIST",
  day: "DAYLIGHT",
  night: "NIGHT",
  crimson: "CRIMSON",
};
const readingSceneLabel = sceneLabels[readingScene] ?? readingScene.toUpperCase();
---

<BaseLayout title={data.title} description={data.description}>
  <div
    class="reading-system"
    data-reading-scene={readingScene}
    data-reading-record={currentRecord?.number ?? "01"}
    style={`--reading-scene-art:url('${sceneArt}')`}
  >
    <div class="reading-atmosphere" aria-hidden="true"></div>
    <div class="reading-progress" aria-hidden="true"><span></span></div>

    <header class="reading-chrome" id="reading-top">
      <a class="reading-brand" href="/" data-reading-transition>
        <span>{siteConfig.name}</span>
        <small>{siteConfig.latinName}</small>
      </a>
      <p class="reading-scene-cue">
        <small>SCENE</small>
        <strong>{readingSceneLabel}</strong>
        <span>RECORD {currentRecord?.number ?? "01"}</span>
      </p>
      <nav class="reading-route-nav" aria-label="阅读页面导航">
        <a class="is-load" href="/?screen=load" data-reading-transition>文章归档</a>
        {olderPost && <a class="is-previous" href={postHref(olderPost)} data-reading-transition>上一篇</a>}
        {newerPost && <a class="is-next" href={postHref(newerPost)} data-reading-transition>下一篇</a>}
        <a class="is-top" href="#reading-top">页首</a>
      </nav>
    </header>

    <main class="reading-main">
      <article lang={normalizePostLocale(data.lang)}>
        <header class="record-opening">
          <div class="record-opening-copy">
            <p class="record-kicker">
              <span>{currentRecord?.label ?? data.category ?? "ESSAY"}</span>
              <i aria-hidden="true"></i>
              <small>{readingSceneLabel}</small>
            </p>
            <h1>{data.title}</h1>
            <p class="record-description">{data.description}</p>
            <div class="record-meta">
              <time datetime={data.published.toISOString()}>{formatPostDate(data.published, data.lang)}</time>
              {data.updated && (
                <span>
                  UPDATE <time datetime={data.updated.toISOString()}>{formatPostDate(data.updated, data.lang)}</time>
                </span>
              )}
              {data.category && <span>{data.category}</span>}
            </div>
            {data.tags.length > 0 && (
              <ul class="record-tags" aria-label="标签">
                {data.tags.map((tag) => <li>{tag}</li>)}
              </ul>
            )}
          </div>

          {data.cover && (
            <figure class="record-cover">
              <Image src={data.cover} alt="" format="webp" quality={88} loading="eager" />
            </figure>
          )}
        </header>

        <div class="reading-layout" id="reading-contents">
          {hasTableOfContents && (
            <details class="reading-toc">
              <summary>文章目录</summary>
              <nav>
                {tableOfContents.map((heading) => (
                  <a
                    href={`#${heading.slug}`}
                    data-reading-toc={heading.slug}
                    data-depth={heading.depth}
                  >
                    {heading.text}
                  </a>
                ))}
              </nav>
              <span class="reading-position"><b data-reading-percent>000</b>%</span>
            </details>
          )}

          <section class="reading-paper" id="reading-content" data-reading-content>
            <div class="prose">
              <Content />
            </div>
          </section>
        </div>

        <footer class="record-ending">
          <p class="record-end-mark"><span>RECORD END</span></p>
          <nav class="record-neighbours" aria-label="相邻文章">
            {olderPost && olderRecord ? (
              <a href={postHref(olderPost)} data-reading-transition>
                <small>上一篇 · {olderRecord.number}</small>
                <strong>{olderPost.data.title}</strong>
                <span>{olderRecord.date}</span>
              </a>
            ) : (
              <span class="is-empty"><small>上一篇</small><strong>没有更早的文章</strong></span>
            )}
            {newerPost && newerRecord ? (
              <a href={postHref(newerPost)} data-reading-transition>
                <small>下一篇 · {newerRecord.number}</small>
                <strong>{newerPost.data.title}</strong>
                <span>{newerRecord.date}</span>
              </a>
            ) : (
              <span class="is-empty"><small>下一篇</small><strong>已经是最新文章</strong></span>
            )}
          </nav>
          <a class="return-to-load" href="/?screen=load" data-reading-transition>返回文章归档</a>
        </footer>

        <BlogInteractionScene contextKey={`article:${postHref(post)}`} />
      </article>
    </main>

    <dialog class="reading-term-dialog" data-reading-term-dialog aria-labelledby="reading-term-title">
      <form method="dialog">
        <p class="reading-term-heading"><small>KEYWORD</small><strong id="reading-term-title" data-reading-term-title>术语</strong></p>
        <div class="reading-term-copy">
          <span>潮汐注释</span>
          <p data-reading-term-definition></p>
        </div>
        <button type="submit">继续阅读</button>
      </form>
    </dialog>

    <div class="reading-transition" data-reading-transition-layer aria-hidden="false">
      <span aria-hidden="true"></span>
      <p><small>{siteConfig.latinName}</small><strong>NOW LOADING</strong></p>
    </div>
  </div>

  <script>
    import "../../scripts/reading-page.js";
  </script>
</BaseLayout>
