---
import { type CollectionEntry, render } from "astro:content";
import { siteConfig } from "../../../site.config.mjs";
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogInteractionScene from "../../components/experience/BlogInteractionScene.astro";
import { getExperienceRecords } from "../../lib/experience-records";
import {
  formatPostDate,
  getPublishedPosts,
  normalizePostLocale,
  postHref,
  postSlug,
} from "../../lib/posts";
import "../../styles/markdown.css";
import "../../styles/reading-page.css";
import "../../styles/blog-interaction-scene.css";
import "../../styles/listen-dock.css";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();

  return posts.map((post) => ({
    params: { slug: postSlug(post) },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;
const { data } = post;
const { Content, headings } = await render(post);
const posts = await getPublishedPosts();
const records = await getExperienceRecords();
const postIndex = posts.findIndex((entry) => entry.id === post.id);
const currentRecord = records[postIndex] ?? records[0];
const olderPost = posts[postIndex + 1];
const newerPost = posts[postIndex - 1];
const olderRecord = records[postIndex + 1];
const newerRecord = records[postIndex - 1];
const tableOfContents = headings.filter((heading) => heading.depth === 2);
const hasTableOfContents = tableOfContents.length >= 3;
const readingScene = currentRecord?.scene ?? "mist";
const sceneArt = `/assets/lonely-sea/${readingScene}.png`;
const heroArt = data.cover?.src ?? currentRecord?.coverUrl ?? sceneArt;
const sceneLabels: Record<string, string> = {
  mist: "灰霭",
  day: "晴昼",
  night: "暗夜",
  crimson: "赤夜",
};
const readingSceneLabel = sceneLabels[readingScene] ?? readingScene;
const recordLabel = currentRecord?.label ?? data.category ?? "文章";
---

<BaseLayout title={data.title} description={data.description}>
  <div
    class="reading-system"
    data-reading-scene={readingScene}
    data-reading-record={currentRecord?.number ?? "01"}
    style={`--reading-scene-art:url('${sceneArt}')`}
  >
    <div class="reading-horizon" aria-hidden="true"></div>

    <header class="reading-bar" id="reading-top">
      <div class="reading-bar-inner">
        <a class="reading-back" href="/?screen=load" data-reading-transition>× 返回读取</a>
        <small class="reading-bar-brand">{siteConfig.name}</small>
      </div>
    </header>

    <div class="reading-ledger">
      {hasTableOfContents && (
        <nav class="reading-toc" aria-label="页内索引">
          {tableOfContents.map((heading) => (
            <a href={`#${heading.slug}`} data-reading-toc={heading.slug}>
              {heading.text}
            </a>
          ))}
        </nav>
      )}

      <main class="reading-main">
        <article lang={normalizePostLocale(data.lang)}>
          <p class="record-kicker">
            <span>{recordLabel} · PAGE · {readingSceneLabel}</span>
            <time datetime={data.published.toISOString()}>{formatPostDate(data.published, data.lang)}</time>
          </p>
          <h1>{data.title}</h1>
          <p class="record-description">{data.description}</p>
          <p class="record-meta">
            {data.updated && (
              <span>UPDATE <time datetime={data.updated.toISOString()}>{formatPostDate(data.updated, data.lang)}</time></span>
            )}
            {data.tags.map((tag) => <span>#{tag}</span>)}
          </p>

          <section class="reading-paper" id="reading-content" data-reading-content>
            <figure class="record-print" data-cg={heroArt}>
              <img src={heroArt} alt={`${data.title} 封面`} loading="eager" />
              <figcaption>封面 · 展开</figcaption>
            </figure>
            <div class="prose">
              <Content />
            </div>
          </section>

          <footer class="record-ending">
            <p class="record-end-mark">—— 终 ——</p>
            <nav class="record-neighbours" aria-label="相邻文章">
              {olderPost && olderRecord ? (
                <a href={postHref(olderPost)} data-reading-transition>
                  <small>上一篇 · RECORD {olderRecord.number}</small>
                  <strong>{olderPost.data.title}</strong>
                  <span>{olderRecord.date}</span>
                </a>
              ) : (
                <span class="is-empty"><small>上一篇</small><strong>没有更早的文章</strong></span>
              )}
              {newerPost && newerRecord ? (
                <a href={postHref(newerPost)} data-reading-transition>
                  <small>下一篇 · RECORD {newerRecord.number}</small>
                  <strong>{newerPost.data.title}</strong>
                  <span>{newerRecord.date}</span>
                </a>
              ) : (
                <span class="is-empty"><small>下一篇</small><strong>已经是最新文章</strong></span>
              )}
            </nav>
          </footer>

          <BlogInteractionScene contextKey={`article:${postHref(post)}`} />
        </article>
      </main>
    </div>

    <dialog class="reading-term-dialog" data-reading-term-dialog aria-labelledby="reading-term-title">
      <form method="dialog">
        <p class="reading-term-heading"><small>KEYWORD</small><strong id="reading-term-title" data-reading-term-title>术语</strong></p>
        <div class="reading-term-copy">
          <span>潮汐注释</span>
          <p data-reading-term-definition></p>
        </div>
        <button type="submit">继续阅读</button>
      </form>
    </dialog>

    <dialog class="reading-cg" data-reading-cg-dialog aria-label="封面 CG">
      <img data-reading-cg-img alt="" />
      <form method="dialog"><button type="submit">关闭</button></form>
    </dialog>

    <aside class="listen-dock" id="listen-dock" hidden aria-hidden="true">
      <p class="listen-dock-kicker">
        <span>SOUND TEST</span>
        <span class="listen-dock-modes">
          <button type="button" data-listen-loop aria-pressed="false" aria-label="Repeat this track">LOOP</button>
          <button type="button" data-listen-shuffle aria-pressed="false" aria-label="Shuffle playlist">SHUFFLE</button>
          <button type="button" class="listen-dock-close" data-listen-stop aria-label="Stop playlist">CLOSE</button>
        </span>
      </p>
      <button type="button" class="listen-dock-sleeve" data-listen-toggle aria-pressed="false" aria-label="Play playlist">
        <img data-listen-cover alt="" referrerpolicy="no-referrer">
      </button>
      <p class="listen-dock-copy">
        <strong data-listen-title></strong>
        <small data-listen-artist></small>
      </p>
      <div class="listen-dock-transport">
        <button type="button" data-listen-prev aria-label="Previous track">‹</button>
        <button type="button" data-listen-toggle aria-pressed="false" aria-label="Play playlist">
          <span class="listen-dock-glyph" aria-hidden="true"></span>
        </button>
        <button type="button" data-listen-next aria-label="Next track">›</button>
      </div>
    </aside>

    <div class="reading-transition" data-reading-transition-layer aria-hidden="false">
      <span aria-hidden="true"></span>
      <p><small>{siteConfig.latinName}</small><strong>NOW LOADING</strong></p>
    </div>
  </div>

  <script>
    import "../../scripts/reading-page.js";
  </script>
</BaseLayout>
