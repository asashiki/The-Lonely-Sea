---
import { siteConfig } from "../../site.config.mjs";
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import "../styles/cursor.css";
import "../styles/achievement-toast.css";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  clientRouter?: boolean;
  htmlClass?: string;
}

const {
  title = siteConfig.name,
  description = siteConfig.description,
  noindex = false,
  clientRouter = false,
  htmlClass,
} = Astro.props;

const documentTitle = title === siteConfig.name ? title : `${title} | ${siteConfig.name}`;
const canonicalUrl = new URL(Astro.url.pathname, siteConfig.url);
---

<!doctype html>
<html lang={siteConfig.locale} class={htmlClass}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#071117" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title={`${siteConfig.name} RSS`} href="/rss.xml" />
    <title>{documentTitle}</title>
    {clientRouter && <ClientRouter fallback="swap" />}
    <script is:inline>
      try {
        const value = JSON.parse(localStorage.getItem("lonely-sea-preferences-v2") || "{}");
        document.documentElement.classList.toggle("has-special-cursor", value.specialCursor !== false);
      } catch {
        document.documentElement.classList.add("has-special-cursor");
      }
    </script>
  </head>
  <body>
    <slot />
    <script>
      import { initExperienceAudio } from "../scripts/experience/audio.js";

      initExperienceAudio();
    </script>
  </body>
</html>
