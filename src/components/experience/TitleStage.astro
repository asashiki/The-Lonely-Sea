<div class="scene-stack" aria-hidden="true">
  <div class="scene-image" data-scene="mist"></div>
  <div class="scene-image" data-scene="day"></div>
  <div class="scene-image" data-scene="night"></div>
  <div class="scene-image" data-scene="crimson"></div>
  <div class="atmosphere"></div>
</div>

<div class="weather-veil" aria-hidden="true"></div>
<canvas id="weather-canvas" aria-hidden="true"></canvas>
<div class="grain" aria-hidden="true"></div>
<div class="vignette" aria-hidden="true"></div>

<header class="identity">
  <p class="identity-kicker">ASASHIKI / SCENE STUDY 01</p>
  <h1>孤独之海</h1>
  <p>LONELY SEA — A PLACE BETWEEN MEMORY AND TIDE</p>
</header>

<nav class="title-menu" aria-label="主菜单">
  <p class="menu-note"><span>MAIN MENU</span></p>
  <ol class="menu-list">
    <li><button class="menu-button" type="button" data-command="START"><span class="menu-name" data-text="START">START</span></button></li>
    <li><button class="menu-button" type="button" data-command="LOAD"><span class="menu-name" data-text="LOAD">LOAD</span></button></li>
    <li><button class="menu-button" type="button" data-command="CONTINUE" disabled><span class="menu-name" data-text="CONTINUE">CONTINUE</span></button></li>
    <li><button class="menu-button" type="button" data-command="EXTRA"><span class="menu-name" data-text="EXTRA">EXTRA</span></button></li>
    <li><button class="menu-button" type="button" data-command="OPTION"><span class="menu-name" data-text="OPTION">OPTION</span></button></li>
    <li><button class="menu-button" type="button" data-command="EXIT"><span class="menu-name" data-text="EXIT">EXIT</span></button></li>
  </ol>
  <p class="menu-status" id="menu-status" aria-live="polite">WEATHER TEST / SNOW</p>
</nav>

<aside class="fx-panel" id="fx-panel" aria-label="临时场景与天气测试面板">
  <div class="fx-row">
    <span class="fx-label">SCENE</span>
    <div class="fx-options">
      <button class="fx-button" type="button" data-scene-option="mist" aria-pressed="true">灰霭</button>
      <button class="fx-button" type="button" data-scene-option="day" aria-pressed="false">晴天</button>
      <button class="fx-button" type="button" data-scene-option="night" aria-pressed="false">暗夜</button>
      <button class="fx-button" type="button" data-scene-option="crimson" aria-pressed="false">赤夜</button>
    </div>
  </div>
  <div class="fx-row">
    <span class="fx-label">WEATHER</span>
    <div class="fx-options">
      <button class="fx-button" type="button" data-weather-option="clear" aria-pressed="false">静止</button>
      <button class="fx-button" type="button" data-weather-option="snow" aria-pressed="true">降雪</button>
      <button class="fx-button" type="button" data-weather-option="rain" aria-pressed="false">降雨</button>
      <button class="fx-button" type="button" id="hide-fx">隐藏测试栏</button>
    </div>
  </div>
  <div class="fx-row">
    <span class="fx-label">SYSTEM</span>
    <div class="fx-options">
      <button class="fx-button" type="button" id="replay-opening">重播开场</button>
    </div>
  </div>
</aside>

<button class="fx-reveal" id="show-fx" type="button" hidden>FX TEST</button>
<small class="build-mark">MODERN ROUTE / WEATHER PROTOTYPE</small>
