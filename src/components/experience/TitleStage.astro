---
import { siteConfig } from "../../../site.config.mjs";
import AmbientDock from "./AmbientDock.astro";
---

<div class="scene-stack" aria-hidden="true">
  <div class="scene-image" data-scene="mist"></div>
  <div class="scene-image" data-scene="day"></div>
  <div class="scene-image" data-scene="night"></div>
  <div class="scene-image" data-scene="crimson"></div>
  <div class="atmosphere"></div>
</div>
<div class="stage-wash" aria-hidden="true"></div>

<div class="weather-veil" aria-hidden="true"></div>
<canvas id="weather-canvas" aria-hidden="true"></canvas>
<div class="grain" aria-hidden="true"></div>
<div class="vignette" aria-hidden="true"></div>

<header class="identity">
  <p class="identity-kicker">ASASHIKI / SCENE STUDY 01</p>
  <h1>{siteConfig.name}</h1>
  <p>{siteConfig.latinName} — A PLACE BETWEEN MEMORY AND TIDE</p>
</header>

<nav class="title-menu" aria-label="主菜单">
  <ol class="menu-list">
    <li><button class="menu-button" type="button" data-command="START" data-ui-sound="start"><span class="menu-name" data-text="START">START</span></button></li>
    <li><button class="menu-button" type="button" data-command="LOAD" data-ui-sound="open"><span class="menu-name" data-text="LOAD">LOAD</span></button></li>
    <li><button class="menu-button" type="button" data-command="CONTINUE" data-ui-sound="start" disabled><span class="menu-name" data-text="CONTINUE">CONTINUE</span></button></li>
    <li><button class="menu-button" type="button" data-command="EXTRA" data-ui-sound="open"><span class="menu-name" data-text="EXTRA">EXTRA</span></button></li>
    <li><button class="menu-button" type="button" data-command="OPTION" data-ui-sound="open"><span class="menu-name" data-text="OPTION">OPTION</span></button></li>
    <li><button class="menu-button" type="button" data-command="EXIT" data-ui-sound="open"><span class="menu-name" data-text="EXIT">EXIT</span></button></li>
  </ol>
  <p class="menu-status" id="menu-status" aria-live="polite" hidden></p>
</nav>

<AmbientDock home />
