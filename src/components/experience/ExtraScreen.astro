---
const modes = [
  { id: "cg", label: "CG" },
  { id: "music", label: "MUSIC" },
  { id: "projects", label: "PROJECT" },
  { id: "bangumi", label: "BANGUMI" },
  { id: "movie", label: "MOVIE" },
  { id: "character", label: "CHARACTER" },
  { id: "achievement", label: "ACHIEVE" },
];
---

<section class="system-screen extra-screen" data-screen="extra" aria-hidden="true" aria-label="Extra archive">
  <div class="system-canvas extra-canvas special-system-canvas" id="extra-canvas" data-extra-mode="cg">
    <div class="extra-safe-frame">
      <button class="system-back" type="button" data-back>BACK</button>

      <header class="special-page-heading extra-heading">
        <h2>EXTRA</h2>
      </header>

      <nav class="extra-primary" aria-label="Extra archive sections">
        {modes.map((mode, index) => (
          <button
            type="button"
            data-extra-mode={mode.id}
            aria-pressed={index === 0}
            aria-controls="extra-stage"
          >
            <span>{mode.label}</span>
          </button>
        ))}
      </nav>

      <section class="extra-stage" id="extra-stage" aria-label="Extra archive content"></section>

      <div class="v4-edge-turners extra-edge-turners" aria-label="Archive pages">
        <button type="button" data-extra-page-direction="-1" aria-label="Previous page">‹</button>
        <button type="button" data-extra-page-direction="1" aria-label="Next page">›</button>
      </div>

      <footer class="extra-status">
        <p id="extra-focus" aria-live="polite"><span>SELECT</span><strong>SCENE ARCHIVE</strong><small>OPEN CG</small></p>
        <nav class="extra-page-controls" aria-label="Archive pages">
          <button type="button" data-extra-page-direction="-1" aria-label="Previous page">‹</button>
          <span class="extra-page-count"><b id="extra-page-current">01</b><i>/</i><em id="extra-page-total">02</em></span>
          <span class="extra-page-line" aria-hidden="true"><i id="extra-page-progress"></i></span>
          <button type="button" data-extra-page-direction="1" aria-label="Next page">›</button>
        </nav>
      </footer>


    </div>
    <section class="cg-viewer" id="cg-viewer" role="dialog" aria-modal="true" aria-hidden="true" aria-label="CG GALLERY" tabindex="-1" inert>
      <div class="cg-viewer-art" id="cg-viewer-art">
        <img data-cg-image alt="" decoding="async" hidden />
      </div>
      <div class="cg-theater-controls" data-cg-controls>
        <header class="cg-theater-header">
          <button type="button" data-cg-close>返回</button>
          <p>EXTRA <span>/</span> CG GALLERY</p>
          <div>
            <button type="button" data-cg-index-toggle aria-expanded="false" aria-controls="cg-index">画面索引</button>
            <button type="button" data-cg-clean>纯画面</button>
          </div>
        </header>
        <button class="cg-theater-prev" type="button" data-cg-direction="-1" aria-label="上一张 CG">‹</button>
        <button class="cg-theater-next" type="button" data-cg-direction="1" aria-label="下一张 CG">›</button>
        <footer class="cg-theater-footer">
          <p class="cg-viewer-caption" aria-live="polite" aria-atomic="true">
            <small id="cg-viewer-index"></small>
            <strong id="cg-viewer-title"></strong>
          </p>
          <small data-cg-hint>← → 切换 / H 纯画面 / I 索引 / Esc 返回</small>
        </footer>
      </div>
      <nav class="cg-theater-index" id="cg-index" data-cg-tray aria-label="画面索引" hidden></nav>
      <div class="cg-theater-status">
        <p data-cg-status role="status"></p>
        <button type="button" data-cg-retry hidden>重试</button>
      </div>
      <button class="cg-theater-return" type="button" data-cg-return hidden>显示操作</button>
    </section>
  </div>
</section>
