<section class="system-screen extra-screen" data-screen="extra" aria-hidden="true" aria-label="附加内容">
  <div class="system-canvas extra-canvas" id="extra-canvas" data-extra-mode="album">
    <p class="v4-scene-sign"><span>CURRENT SCENE</span><strong data-scene-label>灰霭</strong></p>
    <button class="system-back" type="button" data-back>BACK</button>
    <header class="sys-heading"><h2>EXTRA</h2><p>COLLECTIONS BEYOND THE MAIN STORY</p></header>
    <nav class="v4-extra-tabs" aria-label="附加内容分类">
      <button type="button" data-v4-extra="cg" aria-pressed="true"><span>01</span>CG ROOM</button>
      <button type="button" data-v4-extra="projects" aria-pressed="false"><span>02</span>PROJECTS</button>
      <button type="button" data-v4-extra="music" aria-pressed="false"><span>03</span>MUSIC</button>
      <button type="button" data-v4-extra="memory" aria-pressed="false"><span>04</span>MEMORY</button>
      <button type="button" data-v4-extra="timeline" aria-pressed="false"><span>05</span>TIMELINE</button>
      <button type="button" data-v4-extra="character" aria-pressed="false"><span>06</span>CHARACTER</button>
    </nav>
    <section class="v4-extra-stage" id="v4-extra-stage" aria-live="polite"></section>
    <p class="v4-extra-hover" id="v4-extra-hover"><span>SELECT</span><strong>灰霭之海</strong><small>CLICK TO VIEW</small></p>
    <div class="v4-edge-turners extra-edge-turners" aria-label="附加内容翻页">
      <button type="button" data-extra-page-direction="-1" aria-label="上一页">‹</button>
      <button type="button" data-extra-page-direction="1" aria-label="下一页">›</button>
    </div>
    <nav class="v4-page-turner extra-page-turner" aria-label="附加内容页码">
      <button type="button" data-extra-page-direction="-1"><span>PREV</span><b>‹</b></button>
      <div class="page-turner-track"><i id="extra-page-progress"></i></div>
      <strong id="extra-page-label">PAGE 01 / 02</strong>
      <button type="button" data-extra-page-direction="1"><b>›</b><span>NEXT</span></button>
    </nav>
    <section class="cg-viewer" id="cg-viewer" aria-hidden="true" aria-label="CG 全屏鉴赏">
      <div class="cg-viewer-art" id="cg-viewer-art"></div>
      <p><small id="cg-viewer-index">CG 01 / 08</small><strong id="cg-viewer-title">灰霭之海</strong></p>
      <button type="button" data-cg-direction="-1" aria-label="上一张 CG">‹</button>
      <button type="button" data-cg-direction="1" aria-label="下一张 CG">›</button>
      <button type="button" class="cg-viewer-close" id="cg-viewer-close">× <span>CLOSE</span></button>
    </section>
  </div>
</section>
