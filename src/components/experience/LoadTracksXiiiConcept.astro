---
import type { ExperienceRecord } from "../../lib/experience-records";
import { LOAD_SLOT_CAPACITY } from "../../lib/experience-records";
import { listPublicStoryFlows, listPublicStoryScenes } from "../../lib/gal-blog/release-registry";

interface Props {
  records: ExperienceRecord[];
}

const { records } = Astro.props;

const articleCategories = [
  { id: "all", label: "ALL" },
  { id: "essay", label: "ESSAY" },
  { id: "anime", label: "ANIME" },
  { id: "project", label: "PROJECT" },
  { id: "note", label: "NOTE" },
];

const gameSections = [
  { id: "save", label: "SAVE DATA" },
  { id: "flow", label: "FLOWCHART" },
  { id: "story", label: "STORY" },
];

const publishedStoryScenes = listPublicStoryScenes();
const storyScenes = publishedStoryScenes.map((scene, index) => ({
  number: String(index + 1).padStart(2, "0"),
  title: scene.title,
  summary: "",
  art: scene.thumbnail ?? "/assets/lonely-sea/mist.png",
  gameSlug: scene.gameSlug,
  releaseId: scene.releaseId,
  sceneId: scene.sceneId,
}));

const diaryMonthNames = [
  "JANUARY", "FEBRUARY", "MARCH", "APRIL", "MAY", "JUNE",
  "JULY", "AUGUST", "SEPTEMBER", "OCTOBER", "NOVEMBER", "DECEMBER",
];
const diaryGroups = new Map<string, ExperienceRecord[]>();
records.forEach((record) => {
  const [year, month] = record.date.split(".");
  if (!year || !month) return;
  const id = `${year}-${month}`;
  diaryGroups.set(id, [...(diaryGroups.get(id) ?? []), record]);
});
const diaryMonths = [...diaryGroups.entries()].map(([id, entries]) => {
  const [year, monthNumber] = id.split("-");
  const first = entries[0];
  const monthIndex = Math.max(0, Math.min(11, Number(monthNumber) - 1));
  const title = entries.length === 1
    ? first.title
    : `${year}年${Number(monthNumber)}月归档`;
  const summary = entries.length === 1
    ? first.excerpt
    : `本月共收录 ${entries.length} 篇文章：${entries.map((entry) => entry.title).join("、")}。`;
  return {
    id,
    year,
    month: diaryMonthNames[monthIndex],
    monthNumber,
    dateLabel: `${year} / ${monthNumber}`,
    title,
    summary,
    art: first.coverUrl,
    records: entries.map((entry) => ({
      title: entry.title,
      date: entry.date,
      url: entry.url,
    })),
  };
});

const diaryYears = [...new Set(diaryMonths.map((entry) => entry.year))];

const flowAtlases = listPublicStoryFlows().map((flow, flowIndex) => {
  const nodeById = new Map(flow.nodes.map((node) => [node.id, node]));
  const incoming = new Map(flow.nodes.map((node) => [node.id, 0]));
  flow.edges.forEach((edge) => incoming.set(edge.target, (incoming.get(edge.target) ?? 0) + 1));
  const roots = flow.nodes.filter((node) => node.kind === "start" || incoming.get(node.id) === 0);
  const depths = new Map<string, number>();
  const queue = roots.map((node) => ({ id: node.id, depth: 0 }));
  while (queue.length) {
    const current = queue.shift();
    if (!current || (depths.has(current.id) && (depths.get(current.id) ?? 0) <= current.depth)) continue;
    depths.set(current.id, current.depth);
    flow.edges.filter((edge) => edge.source === current.id).forEach((edge) => {
      queue.push({ id: edge.target, depth: current.depth + 1 });
    });
  }
  flow.nodes.forEach((node) => {
    if (!depths.has(node.id)) depths.set(node.id, Math.max(0, ...depths.values()) + 1);
  });
  const maxDepth = Math.max(1, ...depths.values());
  const positioned = new Map<string, { x: number; y: number }>();
  for (let depth = 0; depth <= maxDepth; depth += 1) {
    const layer = flow.nodes.filter((node) => depths.get(node.id) === depth);
    layer.forEach((node, index) => positioned.set(node.id, {
      x: ((index + 1) * 100) / (layer.length + 1),
      y: 10 + (depth / maxDepth) * 112,
    }));
  }
  return {
    id: flowIndex === 0 ? "blue" : `story-${flowIndex + 1}`,
    label: flow.title,
    chapters: Array.from({ length: maxDepth + 1 }, (_, depth) => ({
      y: Math.max(3, 10 + (depth / maxDepth) * 112 - 9),
      label: depth === 0 ? "0 / START" : `${depth} / ${depth === 1 ? "MAIN BRANCH" : "DETAIL BRANCH"}`,
    })),
    paths: flow.edges.flatMap((edge) => {
      const source = positioned.get(edge.source);
      const target = positioned.get(edge.target);
      if (!source || !target) return [];
      const middle = (source.y + target.y) / 2;
      return [`M${source.x} ${source.y} V${middle} H${target.x} V${target.y}`];
    }),
    nodes: flow.nodes.map((node, index) => {
      const position = positioned.get(node.id) ?? { x: 50, y: 68 };
      const branchLabels = flow.edges
        .filter((edge) => edge.source === node.id)
        .map((edge) => edge.label || nodeById.get(edge.target)?.title)
        .filter(Boolean);
      return {
        id: node.id,
        number: String(index + 1).padStart(2, "0"),
        title: node.title,
        summary: branchLabels.length ? `后续：${branchLabels.join(" / ")}` : "当前公开路线的终点。",
        art: node.thumbnail ?? "/assets/lonely-sea/mist.png",
        gameSlug: flow.gameSlug,
        releaseId: flow.releaseId,
        sceneId: node.id,
        x: position.x,
        y: position.y,
        unlocked: true,
      };
    }),
  };
});

if (!flowAtlases.length) {
  flowAtlases.push({
    id: "blue",
    label: "NO STORY DATA",
    chapters: [{ y: 3, label: "0 / EMPTY" }],
    paths: [],
    nodes: [{ id: "empty", number: "--", title: "暂无公开流程", summary: "游戏包尚未提供路线图。", art: "", gameSlug: "", releaseId: "", sceneId: "", x: 50, y: 18, unlocked: false }],
  });
}

const initialFlowNode = flowAtlases[0]?.nodes.find((node) => node.unlocked);
const articleEmptySlots = Array.from(
  { length: LOAD_SLOT_CAPACITY },
  (_, index) => index,
);
const saveSlots = Array.from({ length: LOAD_SLOT_CAPACITY }, (_, index) => index);
const lockedStorySlots = Array.from({ length: Math.max(0, 10 - storyScenes.length) }, (_, index) => index);
---

<div
  class="system-canvas load-canvas load-tracks-xiii-canvas tracks-xiii-canvas"
  aria-hidden="false"
  data-xiii-page="articles"
  data-xiii-section="all"
  data-xiii-page-mode="articles"
  data-xiii-flow-theme="blue"
>
  <div class="load-safe-frame">
    <button class="system-back" type="button" data-back>BACK</button>

    <header class="tracks-xiii-heading">
      <h2>LOAD</h2>
    </header>

    <div class="tracks-xiii-primary-shell">
      <nav class="tracks-xiii-primary" aria-label="读取页面">
        <button type="button" data-xiii-page-entry="articles" aria-current="page" aria-controls="tracks-xiii-panel-articles">
          <span>ARTICLES</span>
        </button>
        <button type="button" data-xiii-page-entry="game" aria-current="false" aria-controls="tracks-xiii-panel-game">
          <span>GAME</span>
        </button>
        <button type="button" data-xiii-page-entry="diary" aria-current="false" aria-controls="tracks-xiii-panel-diary">
          <span>DIARY</span>
        </button>
      </nav>
    </div>

    <div class="tracks-xiii-stage">
      <aside class="tracks-xiii-index" aria-label="二级分类">
        <span class="tracks-xiii-index-spine" aria-hidden="true"></span>
        <div class="tracks-xiii-index-stack">
          <div class="tracks-xiii-index-group" data-xiii-index-group="articles" role="tablist" aria-label="文章分类" aria-hidden="false">
            {articleCategories.map((category, index) => (
              <button type="button" role="tab" data-xiii-filter={category.id} aria-selected={index === 0}>
                <span>{category.label}</span>
              </button>
            ))}
          </div>

          <div class="tracks-xiii-index-group" data-xiii-index-group="game" role="tablist" aria-label="游戏记录分类" aria-hidden="true">
            {gameSections.map((section) => (
              <button type="button" role="tab" data-xiii-filter={section.id} aria-selected={section.id === "save"}>
                <span>{section.label}</span>
              </button>
            ))}
          </div>

          <div class="tracks-xiii-index-group tracks-xiii-year-index" data-xiii-index-group="diary" role="tablist" aria-label="日记年份" aria-hidden="true">
            {diaryYears.map((year, index) => (
              <button type="button" role="tab" data-xiii-filter={year} aria-selected={index === 0}>
                <span>{year}</span>
              </button>
            ))}
          </div>
        </div>
      </aside>

      <div class="tracks-xiii-view" data-xiii-view-transition>
        <section class="tracks-xiii-panel tracks-xiii-articles" id="tracks-xiii-panel-articles" data-xiii-panel="articles" role="region" aria-label="文章记录" aria-hidden="false">
          <div class="tracks-xiii-record-grid" data-xiii-article-grid>
            {records.map((record) => (
              <button
                class="tracks-xiii-record-slot"
                type="button"
                data-xiii-article-slot
                data-category={record.archiveCategory}
                data-href={record.url}
                data-cover={record.coverUrl}
                aria-label={"读取文章：" + record.title}
                style={`--record-art:url('${record.coverUrl}')`}
              >
                <span class="tracks-xiii-slot-number" aria-hidden="true">{record.number}</span>
                <span class="tracks-xiii-slot-art" aria-hidden="true"></span>
                <span class="tracks-xiii-slot-copy">
                  <strong>{record.title}</strong>
                  <time datetime={record.date.replaceAll(".", "-")}>{record.date}</time>
                </span>
                <span class="tracks-xiii-slot-command" aria-hidden="true">READ</span>
              </button>
            ))}
            {articleEmptySlots.map((index) => (
              <div class="tracks-xiii-record-slot is-empty" data-xiii-article-empty aria-hidden="true">
                <span class="tracks-xiii-slot-number">{String(index + 1).padStart(2, "0")}</span>
                <span class="tracks-xiii-slot-art" aria-hidden="true"></span>
                <span class="tracks-xiii-slot-copy"><strong>NO RECORD</strong></span>
              </div>
            ))}
          </div>
        </section>

        <section class="tracks-xiii-panel tracks-xiii-game" id="tracks-xiii-panel-game" data-xiii-panel="game" role="region" aria-label="游戏记录" aria-hidden="true">
          <div class="tracks-xiii-game-view tracks-xiii-save-view" data-xiii-game-view="save" aria-hidden="false">
            <div class="tracks-xiii-save-grid">
              {saveSlots.map((index) => (
                <button
                  class="tracks-xiii-save-slot is-empty"
                  type="button"
                  data-xiii-save-slot
                  data-save-number={String(index + 1).padStart(2, "0")}
                  aria-label="空存档槽位"
                  disabled
                >
                  <span class="tracks-xiii-save-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
                  <span class="tracks-xiii-save-art" aria-hidden="true"></span>
                  <span class="tracks-xiii-save-copy">
                    <small><span>NO SAVE DATA</span><span></span></small>
                    <strong>EMPTY SLOT</strong>
                    <span class="tracks-xiii-save-meta">
                      <time><b>SAVE</b><span></span></time>
                      <span><b>TIME</b><span></span></span>
                    </span>
                  </span>
                  <span class="tracks-xiii-save-command" aria-hidden="true">LOAD</span>
                </button>
              ))}
            </div>
          </div>

          <div class="tracks-xiii-game-view tracks-xiii-flow-view" data-xiii-game-view="flow" aria-hidden="true">
            <section class="tracks-xiii-flow-shell" data-xiii-flow-shell aria-label="故事流程图">
              <div class="tracks-xiii-flow-tools">
                <div class="tracks-xiii-flow-themes" role="group" aria-label="切换流程图">
                  {flowAtlases.map((atlas, index) => (
                    <button type="button" data-xiii-flow-theme-option={atlas.id} aria-pressed={index === 0}>{atlas.label}</button>
                  ))}
                </div>
                <button class="tracks-xiii-flow-expand" type="button" data-xiii-flow-expand aria-label="放大流程图" aria-expanded="false">
                  <svg class="is-expand-icon" viewBox="0 0 32 32" aria-hidden="true">
                    <path d="M13 5H5v8M5 5l9 9M19 27h8v-8M27 27l-9-9"></path>
                  </svg>
                  <svg class="is-collapse-icon" viewBox="0 0 32 32" aria-hidden="true">
                    <path d="M14 14H6V6M6 6l9 9M18 18h8v8M26 26l-9-9"></path>
                  </svg>
                </button>
              </div>

              <div class="tracks-xiii-flow-viewport" data-xiii-flow-viewport tabindex="0" aria-label="可拖动的故事流程">
                {flowAtlases.map((atlas, atlasIndex) => (
                  <div class="tracks-xiii-flow-map" data-xiii-flow-map={atlas.id} aria-hidden={atlasIndex !== 0}>
                    <svg viewBox="0 0 100 136" preserveAspectRatio="none" aria-hidden="true">
                      {atlas.chapters.map((chapter) => (
                        <path class="tracks-xiii-flow-boundary" d={`M4 ${chapter.y} H96`}></path>
                      ))}
                      {atlas.paths.map((path) => <path class="tracks-xiii-flow-path" d={path}></path>)}
                    </svg>
                    {atlas.chapters.map((chapter) => (
                      <span class="tracks-xiii-flow-chapter" style={`--chapter-y:${(chapter.y / 136) * 100}%`}>
                        <b>{chapter.label}</b>
                      </span>
                    ))}
                    {atlas.nodes.map((node, nodeIndex) => (
                      <button
                        class:list={["tracks-xiii-flow-node", { "is-locked": !node.unlocked }]}
                        type="button"
                        data-xiii-flow-node={node.unlocked ? node.id : undefined}
                        data-flow-theme={atlas.id}
                        data-flow-number={node.number}
                        data-flow-title={node.title}
                        data-flow-summary={node.summary}
                        data-flow-art={node.art}
                        data-game-slug={node.gameSlug}
                        data-release-id={node.releaseId}
                        data-scene-id={node.sceneId}
                        aria-label={node.unlocked ? node.title : "未解锁场景"}
                        aria-pressed={node.unlocked ? nodeIndex === 0 : undefined}
                        disabled={!node.unlocked}
                        style={`--flow-x:${node.x}%;--flow-y:${(node.y / 136) * 100}%;--node-art:${node.art ? `url('${node.art}')` : "none"}`}
                      >
                        <span class="tracks-xiii-flow-node-art" aria-hidden="true"></span>
                        <span class="tracks-xiii-flow-node-number" aria-hidden="true">{node.unlocked ? node.number : "?"}</span>
                      </button>
                    ))}
                  </div>
                ))}
              </div>

              <div class="tracks-xiii-flow-caption" aria-live="polite">
                <span data-xiii-flow-caption-number>{initialFlowNode?.number}</span>
                <strong data-xiii-flow-caption-title>{initialFlowNode?.title}</strong>
              </div>

              <aside class="tracks-xiii-flow-detail" aria-live="polite">
                <div class="tracks-xiii-flow-detail-paper">
                  <div class="tracks-xiii-flow-detail-art" data-xiii-flow-detail-art style={`--detail-art:url('${initialFlowNode?.art}')`}></div>
                  <div class="tracks-xiii-flow-detail-copy">
                    <small data-xiii-flow-detail-number>SCENE {initialFlowNode?.number}</small>
                    <h3 data-xiii-flow-detail-title>{initialFlowNode?.title}</h3>
                    <p data-xiii-flow-detail-summary>{initialFlowNode?.summary}</p>
                  </div>
                </div>
              </aside>

              <div class="tracks-xiii-flow-hints" aria-hidden="true">
                <span><b>○</b> DECIDE</span><span><b>×</b> BACK</span><span><b>✚</b> MOVE</span><span><b>↕</b> SCROLL</span>
              </div>

              <div class="tracks-xiii-flow-scroll-indicator" data-xiii-flow-scroll-indicator aria-hidden="true">
                <span data-xiii-flow-scroll-thumb></span>
              </div>
            </section>
          </div>

          <div class="tracks-xiii-game-view tracks-xiii-story-view" data-xiii-game-view="story" aria-hidden="true">
            <div class="tracks-xiii-story-scroll" id="tracks-xiii-story-scroll" data-xiii-story-scroll tabindex="0" aria-label="可读取故事场景">
              <div class="tracks-xiii-story-list">
                {storyScenes.map((scene) => (
                  <button
                    class="tracks-xiii-story-slot"
                    type="button"
                    data-xiii-story-slot
                    data-story-number={scene.number}
                    data-story-title={scene.title}
                    data-game-slug={"gameSlug" in scene ? scene.gameSlug : undefined}
                    data-release-id={"releaseId" in scene ? scene.releaseId : undefined}
                    data-scene-id={"sceneId" in scene ? scene.sceneId : undefined}
                    style={`--story-art:url('${scene.art}')`}
                  >
                    <span class="tracks-xiii-story-node" aria-hidden="true"></span>
                    <span class="tracks-xiii-story-art" aria-hidden="true"></span>
                    <span class="tracks-xiii-story-number">{scene.number}</span>
                    <span class="tracks-xiii-story-copy">
                      <strong>{scene.title}</strong>
                      <span>{scene.summary}</span>
                    </span>
                  </button>
                ))}
                {lockedStorySlots.map((_, index) => (
                  <div class="tracks-xiii-story-slot is-locked" aria-label="未解锁故事场景">
                    <span class="tracks-xiii-story-node" aria-hidden="true"></span>
                    <span class="tracks-xiii-story-number">{String(index + storyScenes.length + 1).padStart(2, "0")}</span>
                    <span class="tracks-xiii-story-copy"><strong>LOCKED</strong><span>STORY RECORD IS NOT YET AVAILABLE</span></span>
                  </div>
                ))}
              </div>
            </div>
            <div class="tracks-xiii-story-rail" data-xiii-story-rail role="scrollbar" aria-controls="tracks-xiii-story-scroll" aria-orientation="vertical" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" tabindex="0">
              <span data-xiii-story-thumb></span>
            </div>
          </div>
        </section>

        <section class="tracks-xiii-panel tracks-xiii-diary" id="tracks-xiii-panel-diary" data-xiii-panel="diary" role="region" aria-label="日记记录" aria-hidden="true">
          {diaryMonths.map((entry, index) => (
            <article
              class="tracks-xiii-diary-month"
              data-xiii-diary-month={entry.id}
              data-diary-year={entry.year}
              data-diary-date={entry.dateLabel}
              data-diary-label={`${entry.month} / ${entry.year}`}
              data-diary-title={entry.title}
              data-diary-summary={entry.summary}
              data-diary-art={entry.art}
              data-diary-records={JSON.stringify(entry.records)}
              aria-hidden={index !== 0}
            >
              <span class="tracks-xiii-diary-ghost" aria-hidden="true">{entry.monthNumber}</span>
              <div class="tracks-xiii-diary-copy">
                <time>{entry.dateLabel}</time>
                <small>{entry.month} — MONTHLY ARCHIVE</small>
                <h3>{entry.title}</h3>
                <p>{entry.summary}</p>
                <span>OPEN THIS MONTH</span>
              </div>
              <button class="tracks-xiii-diary-cover" type="button" data-xiii-diary-entry aria-label={`读取 ${entry.dateLabel} 日记`} aria-pressed="false" style={`--diary-art:url('${entry.art}')`}>
                <span class="tracks-xiii-diary-art" aria-hidden="true"></span>
                <span class="tracks-xiii-diary-edge" aria-hidden="true"></span>
                <strong>{entry.month}</strong>
              </button>
            </article>
          ))}

          <section
            class="tracks-xiii-diary-reader"
            data-xiii-diary-reader
            role="dialog"
            aria-modal="true"
            aria-hidden="true"
            aria-label="日记阅读预览"
          >
            <div class="tracks-xiii-diary-reader-art" data-xiii-diary-reader-art style={`--diary-reader-art:url('${diaryMonths[0]?.art}')`} aria-hidden="true"></div>
            <div class="tracks-xiii-diary-reader-copy">
              <time data-xiii-diary-reader-date>{diaryMonths[0]?.dateLabel}</time>
              <h3 data-xiii-diary-reader-title>{diaryMonths[0]?.title}</h3>
              <p data-xiii-diary-reader-summary>{diaryMonths[0]?.summary}</p>
              <nav class="tracks-xiii-diary-reader-links" data-xiii-diary-reader-links aria-label="本月文章"></nav>
            </div>
            <button class="tracks-xiii-diary-reader-close" type="button" data-xiii-diary-reader-close>RETURN</button>
          </section>
        </section>
      </div>
    </div>

    <div class="tracks-xiii-edge-turners" data-xiii-page-controls aria-label="内容翻页">
      <button type="button" data-xiii-page-direction="-1" aria-label="上一页"><span>‹</span></button>
      <button type="button" data-xiii-page-direction="1" aria-label="下一页"><span>›</span></button>
    </div>

    <nav class="tracks-xiii-page-nav" data-xiii-page-nav aria-label="当前内容页码">
      <div class="tracks-xiii-page-markers" data-xiii-page-markers></div>
      <strong data-xiii-page-status></strong>
    </nav>

    <section class="tracks-xiii-story-confirm" data-xiii-story-confirm role="dialog" aria-modal="true" aria-hidden="true" aria-labelledby="tracks-xiii-story-confirm-title">
      <div class="tracks-xiii-story-confirm-shade" aria-hidden="true"></div>
      <div class="tracks-xiii-story-confirm-panel">
        <span data-xiii-story-confirm-number>SCENE 01</span>
        <h3 id="tracks-xiii-story-confirm-title">ENTER THIS STORY?</h3>
        <p data-xiii-story-confirm-title>初次见面</p>
        <div>
          <button type="button" data-xiii-story-enter>ENTER</button>
          <button type="button" data-xiii-story-cancel>CANCEL</button>
        </div>
      </div>
    </section>

  </div>
</div>
