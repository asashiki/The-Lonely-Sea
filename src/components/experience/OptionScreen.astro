---
import {
  DEFAULT_SOUND_SELECTION,
  SOUND_CATEGORIES,
  SOUND_CUE_LABELS,
  SOUND_PRESETS,
} from "../../scripts/experience/sound-design.js";

type SoundPresetView = {
  id: string;
  title: string;
  latin: string;
  category: string;
  cue: string;
  duration: number;
  description: string;
  tags: string[];
};
const soundPresets = SOUND_PRESETS as unknown as SoundPresetView[];
const cueLabels = SOUND_CUE_LABELS as unknown as Record<string, string>;
const defaultSoundSelection = DEFAULT_SOUND_SELECTION as unknown as Record<string, string>;

const categories = [
  {
    id: "system",
    label: "系统",
    latin: "SYSTEM",
    subcategories: [
      { id: "language", label: "语言" },
      { id: "accessibility", label: "操作与无障碍" },
      { id: "data", label: "本机数据" },
    ],
  },
  {
    id: "game",
    label: "游戏",
    latin: "GAME",
    subcategories: [
      { id: "text", label: "文字" },
      { id: "sound", label: "声音" },
      { id: "sound-lab", label: "音效试听" },
      { id: "display", label: "显示与操作" },
    ],
  },
  {
    id: "blog",
    label: "博客",
    latin: "BLOG",
    subcategories: [
      { id: "reading", label: "阅读" },
      { id: "atmosphere", label: "海景" },
      { id: "behaviour", label: "页面行为" },
    ],
  },
];
---

<section id="option-screen" class="system-screen option-screen" data-screen="option" aria-hidden="true" aria-label="设置">
  <div class="system-canvas option-canvas special-system-canvas" data-option-category="system" data-option-subcategory="language">
    <div class="option-safe-frame">
      <header class="special-page-heading option-heading">
        <h2>OPTION</h2>
        <p data-option-context>系统设定</p>
      </header>

      <nav class="option-primary" role="tablist" aria-label="设置分类">
        {categories.map((category, index) => (
          <button
            type="button"
            role="tab"
            data-option-primary={category.id}
            aria-selected={index === 0 ? "true" : "false"}
            aria-controls={`option-secondary-${category.id}`}
            tabindex={index === 0 ? 0 : -1}
          >
            <span>{category.label}</span>
            <small aria-hidden="true">{category.latin}</small>
          </button>
        ))}
      </nav>

      <div class="option-book">
        <div class="option-secondary-shell">
          {categories.map((category, categoryIndex) => (
            <nav
              id={`option-secondary-${category.id}`}
              class="option-secondary"
              data-option-secondary-group={category.id}
              role="tablist"
              aria-label={`${category.label}设置`}
              hidden={categoryIndex !== 0}
            >
              {category.subcategories.map((subcategory, subcategoryIndex) => (
                <button
                  type="button"
                  role="tab"
                  data-option-secondary={subcategory.id}
                  data-option-category-owner={category.id}
                  aria-selected={categoryIndex === 0 && subcategoryIndex === 0 ? "true" : "false"}
                  aria-controls={`option-panel-${subcategory.id}`}
                  tabindex={categoryIndex === 0 && subcategoryIndex === 0 ? 0 : -1}
                >
                  {subcategory.label}
                </button>
              ))}
            </nav>
          ))}
        </div>

        <main class="option-main" data-option-main>
          <section id="option-panel-language" class="option-panel" data-option-panel="language" data-option-panel-owner="system" role="tabpanel">
            <header class="option-panel-intro">
              <h3>语言</h3>
              <p>当前 Blog 内容版本</p>
            </header>
            <div class="option-settings">
              <div class="option-setting" data-setting-key="language" data-setting-scope="blog">
                <div class="option-setting-copy"><strong>显示语言</strong><span>当前内容版本</span></div>
                <div class="option-setting-control">
                  <div class="option-choice-group" data-setting-choice role="radiogroup" aria-label="语言">
                    <button type="button" role="radio" data-setting-value="ZH-CN" aria-checked="true">简体中文</button>
                    <button type="button" role="radio" data-setting-value="EN-US" aria-checked="false">English</button>
                    <button type="button" role="radio" data-setting-value="JA-JP" aria-checked="false">日本語</button>
                  </div>
                </div>
              </div>
            </div>
            <p class="option-panel-note">语言选择会同步给 Blog 与游戏；尚未翻译的正文暂时保留原文。</p>
          </section>

          <section id="option-panel-accessibility" class="option-panel" data-option-panel="accessibility" data-option-panel-owner="system" role="tabpanel" hidden>
            <header class="option-panel-intro">
              <h3>操作与无障碍</h3>
              <p>对 Blog 与游戏宿主即时生效</p>
            </header>
            <div class="option-settings">
              <div class="option-setting" data-setting-key="specialCursor" data-setting-scope="blog">
                <div class="option-setting-copy"><strong>海潮指针</strong><span>Blog 标题与系统页面</span></div>
                <div class="option-setting-control"><button class="option-switch" type="button" data-setting-toggle aria-pressed="true" aria-label="特殊指针"><i aria-hidden="true"></i><output class="setting-value">开</output></button></div>
              </div>
              <div class="option-setting" data-setting-key="keyboardCursor" data-setting-scope="blog">
                <div class="option-setting-copy"><strong>LOAD 键盘焦点</strong><span>索引与存档槽</span></div>
                <div class="option-setting-control"><button class="option-switch" type="button" data-setting-toggle aria-pressed="true" aria-label="方向键导航"><i aria-hidden="true"></i><output class="setting-value">开</output></button></div>
              </div>
              <div class="option-setting" data-setting-key="reducedMotion" data-setting-scope="blog game">
                <div class="option-setting-copy"><strong>减少动态效果</strong><span>转场与游戏演出</span></div>
                <div class="option-setting-control"><button class="option-switch" type="button" data-setting-toggle aria-pressed="false" aria-label="减少动态效果"><i aria-hidden="true"></i><output class="setting-value">关</output></button></div>
              </div>
            </div>
          </section>

          <section id="option-panel-data" class="option-panel" data-option-panel="data" data-option-panel-owner="system" role="tabpanel" hidden>
            <header class="option-panel-intro">
              <h3>本机数据</h3>
              <p>仅保存在这台设备</p>
            </header>
            <div class="option-settings">
              <div class="option-setting" data-setting-key="smartPreload" data-setting-scope="blog">
                <div class="option-setting-copy"><strong>预先读取相邻文章</strong><span>空闲时载入上一篇与下一篇</span></div>
                <div class="option-setting-control"><button class="option-switch" type="button" data-setting-toggle aria-pressed="true" aria-label="预先读取相邻文章"><i aria-hidden="true"></i><output class="setting-value">开</output></button></div>
              </div>
              <div class="option-setting" data-setting-key="dataSaver" data-setting-scope="blog">
                <div class="option-setting-copy"><strong>停用文章预读</strong><span>减少相邻文章预取流量</span></div>
                <div class="option-setting-control"><button class="option-switch" type="button" data-setting-toggle aria-pressed="false" aria-label="节省流量"><i aria-hidden="true"></i><output class="setting-value">关</output></button></div>
              </div>
              <div class="option-setting option-command-setting">
                <div class="option-setting-copy"><strong>恢复默认设置</strong><span>不会删除文章进度与游戏存档</span></div>
                <div class="option-setting-control"><button class="option-command" type="button" id="reset-options">恢复默认</button></div>
              </div>
              <div class="option-setting option-command-setting">
                <div class="option-setting-copy"><strong>清除本浏览器数据</strong><span>删除设置、阅读进度、存档与离线缓存</span></div>
                <div class="option-setting-control"><button class="option-command option-command-danger" type="button" id="clear-browser-data">清除全部</button></div>
              </div>
            </div>
          </section>

          <section id="option-panel-text" class="option-panel" data-option-panel="text" data-option-panel-owner="game" role="tabpanel" hidden>
            <header class="option-panel-intro">
              <h3>文字</h3>
              <p>视觉小说对话</p>
            </header>
            <div class="option-settings">
              <div class="option-setting" data-setting-key="textSize" data-setting-scope="game blog">
                <div class="option-setting-copy"><strong>对话文字大小</strong><span>同时用于文章正文</span></div>
                <div class="option-setting-control"><label class="option-range"><span>小</span><input type="range" name="text-size" min="80" max="120" step="1" data-setting-range aria-label="对话文字大小"><span>大</span></label><output class="setting-value">100%</output></div>
              </div>
              <div class="option-setting" data-setting-key="autoSpeed" data-setting-scope="game">
                <div class="option-setting-copy"><strong>文字推进速度</strong><span>WebGAL 文字显示速度</span></div>
                <div class="option-setting-control"><label class="option-range"><span>慢</span><input type="range" name="text-speed" min="1" max="10" step="1" data-setting-range data-suffix="" aria-label="文字推进速度"><span>快</span></label><output class="setting-value">第 6 档</output></div>
              </div>
            </div>
          </section>

          <section id="option-panel-sound" class="option-panel" data-option-panel="sound" data-option-panel-owner="game" role="tabpanel" hidden>
            <header class="option-panel-intro">
              <h3>声音</h3>
              <p>Blog 与游戏共用音量</p>
            </header>
            <div class="option-settings option-settings-dense">
              <div class="option-setting" data-setting-key="masterMuted" data-setting-scope="game blog">
                <div class="option-setting-copy"><strong>全部静音</strong><span>所有音轨</span></div>
                <div class="option-setting-control"><button class="option-switch" type="button" data-setting-toggle aria-pressed="false" aria-label="全部静音"><i aria-hidden="true"></i><output class="setting-value">关</output></button></div>
              </div>
              <div class="option-setting" data-setting-key="bgmEnabled" data-setting-scope="game blog">
                <div class="option-setting-copy"><strong>背景音乐</strong><span>标题、文章与游戏 BGM</span></div>
                <div class="option-setting-control"><button class="option-switch" type="button" data-setting-toggle aria-pressed="true" aria-label="背景音乐"><i aria-hidden="true"></i><output class="setting-value">开</output></button></div>
              </div>
              <div class="option-setting" data-setting-key="bgmVolume" data-setting-scope="game blog">
                <div class="option-setting-copy"><strong>音乐音量</strong><span>BGM</span></div>
                <div class="option-setting-control"><label class="option-range"><span>小</span><input type="range" name="bgm-volume" min="0" max="100" step="1" data-setting-range aria-label="背景音乐音量"><span>大</span></label><output class="setting-value">60%</output></div>
              </div>
              <div class="option-setting" data-setting-key="interfaceVolume" data-setting-scope="game blog">
                <div class="option-setting-copy"><strong>界面音效</strong><span>确认、返回与推进</span></div>
                <div class="option-setting-control"><label class="option-range"><span>小</span><input type="range" name="interface-volume" min="0" max="100" step="1" data-setting-range aria-label="界面音效音量"><span>大</span></label><output class="setting-value">70%</output></div>
              </div>
              <div class="option-setting" data-setting-key="voiceVolume" data-setting-scope="game">
                <div class="option-setting-copy"><strong>角色语音</strong><span>VOICE</span></div>
                <div class="option-setting-control"><label class="option-range"><span>小</span><input type="range" name="voice-volume" min="0" max="100" step="1" data-setting-range aria-label="角色语音音量"><span>大</span></label><output class="setting-value">80%</output></div>
              </div>
            </div>
          </section>

          <section id="option-panel-sound-lab" class="option-panel sound-lab" data-option-panel="sound-lab" data-option-panel-owner="game" data-sound-lab data-ui-sound="none" role="tabpanel" hidden>
            <header class="option-panel-intro sound-lab-heading">
              <div>
                <h3>音效试听台</h3>
                <p>SOUND SPECIMEN ARCHIVE · {soundPresets.length} 种实时音色</p>
              </div>
              <button type="button" class="sound-lab-reset" data-sound-reset>恢复初始方案</button>
            </header>

            <div class="sound-lab-monitor">
              <div class="sound-lab-scope" data-sound-scope>
                <canvas width="960" height="168" data-sound-canvas aria-hidden="true"></canvas>
                <span class="sound-lab-scope-label">LIVE / STEREO</span>
                <span class="sound-lab-scope-time" data-sound-time>00.00</span>
              </div>
              <div class="sound-lab-now">
                <span class="sound-lab-now-index" data-sound-index>—</span>
                <p><small>NOW AUDITIONING</small><strong data-sound-now>选择任意标本试听</strong><span data-sound-now-detail>试听期间会暂时收起背景音乐</span></p>
                <button type="button" data-sound-stop disabled><i aria-hidden="true"></i>停止尾音</button>
              </div>
            </div>

            <section class="sound-lab-palette" aria-label="当前采用的音效方案">
              <header><strong>当前采用</strong><span>选择后立即用于 Blog 界面</span></header>
              <div class="sound-lab-slots">
                {Object.entries(defaultSoundSelection).map(([cue, id]) => {
                  const selected = soundPresets.find((item) => item.id === id);
                  return (
                    <button type="button" data-sound-slot={cue} title={`查看${cueLabels[cue]}音效`}>
                      <small>{cueLabels[cue]}</small>
                      <span data-sound-slot-title>{selected?.title}</span>
                    </button>
                  );
                })}
              </div>
            </section>

            <div class="sound-lab-tools">
              <nav class="sound-lab-filters" aria-label="音效分类">
                {SOUND_CATEGORIES.map((category, index) => (
                  <button type="button" data-sound-filter={category.id} aria-pressed={index === 0 ? "true" : "false"}>
                    <span>{category.label}</span><small>{category.latin}</small>
                  </button>
                ))}
              </nav>
              <label class="sound-lab-search">
                <span>搜索</span>
                <input type="search" data-sound-search placeholder="钢琴、卷轴、长尾…" autocomplete="off" />
                <i aria-hidden="true"></i>
              </label>
            </div>

            <p class="sound-lab-result"><span data-sound-result>{soundPresets.length} 个音色</span><small>点击圆形播放键试听；“选用”会替换对应动作的声音。</small></p>

            <div class="sound-lab-grid" data-sound-grid>
              {soundPresets.map((sound, index) => {
                const selected = defaultSoundSelection[sound.cue] === sound.id;
                const category = SOUND_CATEGORIES.find((item) => item.id === sound.category);
                return (
                  <article
                    class="sound-card"
                    data-sound-card={sound.id}
                    data-sound-category={sound.category}
                    data-sound-cue={sound.cue}
                    data-sound-search-text={`${sound.title} ${sound.latin} ${sound.description} ${sound.tags.join(" ")} ${cueLabels[sound.cue]}`.toLocaleLowerCase("zh-CN")}
                    data-selected={String(selected)}
                  >
                    <button type="button" class="sound-card-play" data-sound-preview={sound.id} aria-label={`试听${sound.title}`} aria-pressed="false">
                      <span class="sound-card-play-ring" aria-hidden="true"><i></i></span>
                    </button>
                    <div class="sound-card-copy">
                      <p class="sound-card-meta"><span>{String(index + 1).padStart(2, "0")} / {category?.latin}</span><time>{sound.duration.toFixed(1)}s</time></p>
                      <h4>{sound.title}</h4>
                      <small>{sound.latin}</small>
                      <p>{sound.description}</p>
                      <ul aria-label="音色特征">{sound.tags.map((tag) => <li>{tag}</li>)}</ul>
                    </div>
                    <button type="button" class="sound-card-select" data-sound-select={sound.id} data-sound-target={sound.cue} aria-pressed={selected}>
                      <span data-sound-select-label>{selected ? "正在使用" : "选用"}</span>
                      <small>用于 {cueLabels[sound.cue]}</small>
                    </button>
                  </article>
                );
              })}
            </div>
          </section>

          <section id="option-panel-display" class="option-panel" data-option-panel="display" data-option-panel-owner="game" role="tabpanel" hidden>
            <header class="option-panel-intro">
              <h3>显示与操作</h3>
              <p>游戏宿主画面</p>
            </header>
            <div class="option-settings">
              <div class="option-setting option-command-setting">
                <div class="option-setting-copy"><strong>全屏显示</strong><span>再次选择可退出</span></div>
                <div class="option-setting-control"><button class="option-command" type="button" id="option-toggle-fullscreen" aria-pressed="false">进入全屏</button></div>
              </div>
            </div>
          </section>

          <section id="option-panel-reading" class="option-panel" data-option-panel="reading" data-option-panel-owner="blog" role="tabpanel" hidden>
            <header class="option-panel-intro">
              <h3>阅读</h3>
              <p>文章 PAGE</p>
            </header>
            <div class="option-settings">
              <div class="option-setting" data-setting-key="typeset" data-setting-scope="blog">
                <div class="option-setting-copy"><strong>正文排版</strong><span>长文或小说式留白</span></div>
                <div class="option-setting-control"><div class="option-choice-group" data-setting-choice role="radiogroup" aria-label="正文排版"><button type="button" role="radio" data-setting-value="BLOG" aria-checked="true">长文</button><button type="button" role="radio" data-setting-value="NOVEL" aria-checked="false">小说</button></div></div>
              </div>
              <div class="option-setting" data-setting-key="readingLineHeight" data-setting-scope="blog">
                <div class="option-setting-copy"><strong>正文行距</strong><span>仅影响文章</span></div>
                <div class="option-setting-control"><label class="option-range"><span>紧</span><input type="range" name="reading-line-height" min="150" max="210" step="5" data-setting-range aria-label="正文行距"><span>松</span></label><output class="setting-value">180%</output></div>
              </div>
              <div class="option-setting" data-setting-key="autoSavePosition" data-setting-scope="blog">
                <div class="option-setting-copy"><strong>记录阅读位置</strong><span>供 CONTINUE 继续阅读</span></div>
                <div class="option-setting-control"><button class="option-switch" type="button" data-setting-toggle aria-pressed="true" aria-label="记录阅读位置"><i aria-hidden="true"></i><output class="setting-value">开</output></button></div>
              </div>
            </div>
          </section>

          <section id="option-panel-atmosphere" class="option-panel" data-option-panel="atmosphere" data-option-panel-owner="blog" role="tabpanel" hidden>
            <header class="option-panel-intro">
              <h3>海景</h3>
              <p>标题与系统页面共用</p>
            </header>
            <div class="option-settings option-settings-dense">
              <div class="option-setting" data-experience-key="scene">
                <div class="option-setting-copy"><strong>背景时段</strong><span>四种主场景</span></div>
                <div class="option-setting-control"><div class="option-choice-group option-choice-group-wide" data-experience-choice role="radiogroup" aria-label="背景时段"><button type="button" role="radio" data-setting-value="mist">灰霭</button><button type="button" role="radio" data-setting-value="day">晴昼</button><button type="button" role="radio" data-setting-value="night">暗夜</button><button type="button" role="radio" data-setting-value="crimson">赤夜</button></div></div>
              </div>
              <div class="option-setting" data-experience-key="weather">
                <div class="option-setting-copy"><strong>天气</strong><span>标题与系统页共用</span></div>
                <div class="option-setting-control"><div class="option-choice-group" data-experience-choice role="radiogroup" aria-label="天气"><button type="button" role="radio" data-setting-value="clear">无</button><button type="button" role="radio" data-setting-value="snow">雪</button><button type="button" role="radio" data-setting-value="rain">雨</button></div></div>
              </div>
              <div class="option-setting" data-setting-key="systemWeather" data-setting-scope="blog">
                <div class="option-setting-copy"><strong>系统页延续天气</strong><span>LOAD、EXTRA、OPTION 继续下雨或下雪，不重新开始</span></div>
                <div class="option-setting-control"><button class="option-switch" type="button" data-setting-toggle aria-pressed="true" aria-label="系统页延续天气"><i aria-hidden="true"></i><output class="setting-value">开</output></button></div>
              </div>
              <div class="option-setting" data-setting-key="weatherLayer" data-setting-scope="blog" data-hint="组件内会透过毛玻璃看见天气；盖过 UI 则让粒子浮在界面之上">
                <div class="option-setting-copy"><strong>天气层次</strong><span>特效在组件里，或盖过 UI</span></div>
                <div class="option-setting-control"><div class="option-choice-group" data-setting-choice role="radiogroup" aria-label="天气层次"><button type="button" role="radio" data-setting-value="INSIDE" aria-checked="true">组件内</button><button type="button" role="radio" data-setting-value="OVERLAY" aria-checked="false">盖过 UI</button></div></div>
              </div>
              <div class="option-setting" data-setting-key="particleDensity" data-setting-scope="blog">
                <div class="option-setting-copy"><strong>天气密度</strong><span>雪与雨的数量</span></div>
                <div class="option-setting-control"><label class="option-range"><span>少</span><input type="range" name="particle-density" min="0" max="100" step="1" data-setting-range aria-label="天气密度"><span>多</span></label><output class="setting-value">72%</output></div>
              </div>
              <div class="option-setting" data-setting-key="vignette" data-setting-scope="blog">
                <div class="option-setting-copy"><strong>标题画面暗角</strong><span>仅影响 TITLE</span></div>
                <div class="option-setting-control"><button class="option-switch" type="button" data-setting-toggle aria-pressed="true" aria-label="画面暗角"><i aria-hidden="true"></i><output class="setting-value">开</output></button></div>
              </div>
            </div>
          </section>

          <section id="option-panel-behaviour" class="option-panel" data-option-panel="behaviour" data-option-panel-owner="blog" role="tabpanel" hidden>
            <header class="option-panel-intro">
              <h3>页面行为</h3>
              <p>打开、离开与外部链接</p>
            </header>
            <div class="option-settings option-settings-dense">
              <div class="option-setting" data-setting-key="mobileLandscape" data-setting-scope="blog" data-hint="手机打开标题与系统页时自动横屏。文章页保持竖屏阅读">
                <div class="option-setting-copy"><strong>手机自动横屏</strong><span>标题、LOAD、EXTRA、OPTION</span></div>
                <div class="option-setting-control"><button class="option-switch" type="button" data-setting-toggle aria-pressed="true" aria-label="手机自动横屏"><i aria-hidden="true"></i><output class="setting-value">开</output></button></div>
              </div>
              <div class="option-setting" data-setting-key="sceneCrossfade" data-setting-scope="blog">
                <div class="option-setting-copy"><strong>系统页面转场</strong><span>标题、LOAD、EXTRA 与 OPTION</span></div>
                <div class="option-setting-control"><button class="option-switch" type="button" data-setting-toggle aria-pressed="true" aria-label="系统页面转场"><i aria-hidden="true"></i><output class="setting-value">开</output></button></div>
              </div>
              <div class="option-setting" data-setting-key="articleTransition" data-setting-scope="blog">
                <div class="option-setting-copy"><strong>文章转场</strong><span>LOAD 与 PAGE 之间</span></div>
                <div class="option-setting-control"><button class="option-switch" type="button" data-setting-toggle aria-pressed="true" aria-label="文章转场"><i aria-hidden="true"></i><output class="setting-value">开</output></button></div>
              </div>
              <div class="option-setting" data-setting-key="openingBehaviour" data-setting-scope="blog">
                <div class="option-setting-copy"><strong>开场演出</strong><span>进入标题时</span></div>
                <div class="option-setting-control"><div class="option-choice-group" data-setting-choice role="radiogroup" aria-label="开场演出"><button type="button" role="radio" data-setting-value="ONCE">每次会话</button><button type="button" role="radio" data-setting-value="ALWAYS">每次进入</button></div></div>
              </div>
              <div class="option-setting" data-setting-key="externalLinks" data-setting-scope="blog">
                <div class="option-setting-copy"><strong>站外链接</strong><span>离开当前文章时</span></div>
                <div class="option-setting-control"><div class="option-choice-group" data-setting-choice role="radiogroup" aria-label="站外链接"><button type="button" role="radio" data-setting-value="NEW">新标签页</button><button type="button" role="radio" data-setting-value="CURRENT">当前页面</button></div></div>
              </div>
              <div class="option-setting option-command-setting">
                <div class="option-setting-copy"><strong>开场演出预览</strong><span>立即回到标题播放</span></div>
                <div class="option-setting-control"><button class="option-command" type="button" id="option-replay-opening">重播开场</button></div>
              </div>
            </div>
          </section>
        </main>
      </div>

      <footer class="option-actions">
        <p class="option-state" aria-live="polite"><i aria-hidden="true"></i><span data-option-state>设置即时保存</span></p>
        <button class="system-back" type="button" data-back aria-label="返回标题">BACK</button>
      </footer>
    </div>
  </div>
</section>
