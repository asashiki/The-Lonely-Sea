---
import { socialLinks } from "../../data/social-links";
import SocialMark from "./SocialMark.astro";
---

<section class="exit-dialog" id="exit-dialog" aria-hidden="true" aria-label="我的社交链接">
  <button class="exit-dialog-scrim" type="button" data-close-exit aria-label="返回主菜单"></button>
  <div class="exit-dialog-card" role="dialog" aria-modal="true" aria-labelledby="exit-dialog-title">
    <h2 id="exit-dialog-title">MY LINKS</h2>

    <nav class="exit-dialog-links" aria-label="社交账号">
      {socialLinks.map((link) => (
        <a
          class="exit-dialog-link"
          data-exit-link
          data-exit-id={link.id}
          href={link.href}
          rel="noreferrer"
          aria-label={link.label}
        >
          <SocialMark id={link.id} />
          <span class="exit-dialog-link-label">{link.label}</span>
        </a>
      ))}
    </nav>

    <button class="exit-dialog-return" type="button" data-close-exit aria-label="返回主菜单">
      <svg viewBox="0 0 32 32" aria-hidden="true">
        <path fill="currentColor" d="M26.67 14.67H10.44l7.45-7.45L16 4.67 5.33 16 16 27.33l1.89-1.88-7.45-7.45h16.23z" />
      </svg>
      <span>BACK</span>
    </button>
  </div>
</section>
