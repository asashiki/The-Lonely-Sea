<section class="exit-dialog" id="exit-dialog" aria-hidden="true" aria-label="退出确认">
  <button class="exit-dialog-scrim" type="button" data-close-exit aria-label="关闭退出确认"></button>
  <div class="exit-dialog-card" role="dialog" aria-modal="true" aria-labelledby="exit-dialog-title">
    <div class="exit-dialog-chapter" aria-hidden="true">
      <span>END</span>
      <strong>SESSION</strong>
    </div>
    <div class="exit-dialog-message">
      <p class="exit-dialog-overline">SYSTEM</p>
      <h2 id="exit-dialog-title">要结束本次阅览吗？</h2>
      <p>阅读位置与设置会保留在这片海上。</p>
    </div>
    <div class="exit-dialog-actions">
      <button type="button" data-exit-modal-answer="yes">
        <span>YES</span>
        <small>END SESSION</small>
      </button>
      <button type="button" data-exit-modal-answer="no">
        <span>NO</span>
        <small>RETURN</small>
      </button>
    </div>
  </div>
</section>
