---
import type { ExperienceRecord } from "../../lib/experience-records";
import { LOAD_SLOT_CAPACITY } from "../../lib/experience-records";
import "../../styles/load-tracks-x.css";

interface Props {
  records: ExperienceRecord[];
}

const { records } = Astro.props;

const articleCategories = [
  { id: "all", label: "ALL" },
  { id: "essay", label: "ESSAY" },
  { id: "anime", label: "ANIME" },
  { id: "project", label: "PROJECT" },
  { id: "note", label: "NOTE" },
];

const gameSections = [
  { id: "save", label: "SAVE DATA" },
  { id: "flow", label: "FLOWCHART" },
  { id: "story", label: "STORY" },
];

const demoSaves = [
  {
    title: "序章：来到孤独之海",
    savedAt: "2026.07.24 21:14",
    art: "/assets/lonely-sea/mist.png",
  },
  {
    title: "第一幕：关于我",
    savedAt: "2026.07.24 21:32",
    art: "/assets/lonely-sea/day.png",
  },
];

const storyScenes = [
  {
    title: "初次见面",
    summary: "关于我，以及这片个人档案为什么被保存下来。",
    art: "/assets/lonely-sea/mist.png",
  },
  {
    title: "孤独之海",
    summary: "从一处个人博客开始，重新整理散落的文章与记忆。",
    art: "/assets/lonely-sea/day.png",
  },
  {
    title: "阅读这份记录",
    summary: "在文章、故事与日记之间，选择接下来要读取的内容。",
    art: "/assets/lonely-sea/night.png",
  },
];

const diaryMonths = [
  {
    id: "2026-07",
    year: "2026",
    month: "JULY",
    dateLabel: "2026 / 07",
    title: "雨后的窗边",
    summary: "七月在潮湿的空气里慢慢展开。窗外的雨声、深夜的屏幕，以及一些终于愿意写下来的想法。",
    art: "/assets/lonely-sea/mist.png",
  },
  {
    id: "2026-04",
    year: "2026",
    month: "APRIL",
    dateLabel: "2026 / 04",
    title: "春日归档",
    summary: "天气开始变暖，旧文章也被重新翻开。这个月记下了整理博客时反复想起的人和事。",
    art: "/assets/lonely-sea/day.png",
  },
  {
    id: "2026-01",
    year: "2026",
    month: "JANUARY",
    dateLabel: "2026 / 01",
    title: "新年的第一页",
    summary: "新年没有宏大的计划，只想先把散落的文字放回它们应该在的位置。",
    art: "/assets/lonely-sea/night.png",
  },
  {
    id: "2025-12",
    year: "2025",
    month: "DECEMBER",
    dateLabel: "2025 / 12",
    title: "雪夜与告别",
    summary: "一年的末尾总像一场缓慢的退潮。雪落下来时，许多事情终于能够安静地告别。",
    art: "/assets/lonely-sea/night.png",
  },
  {
    id: "2025-08",
    year: "2025",
    month: "AUGUST",
    dateLabel: "2025 / 08",
    title: "盛夏余波",
    summary: "白昼很长，蝉鸣也很近。这个月留下的是游戏、旅行，以及被暑气拉长的夜晚。",
    art: "/assets/lonely-sea/day.png",
  },
  {
    id: "2025-05",
    year: "2025",
    month: "MAY",
    dateLabel: "2025 / 05",
    title: "五月的月光",
    summary: "五月读完了一些故事，也重新理解了曾经喜欢它们的自己。月光仍旧照在同一片海上。",
    art: "/assets/lonely-sea/crimson.png",
  },
];

const diaryYears = [...new Set(diaryMonths.map((entry) => entry.year))];

const flowNodes = [
  {
    id: "prologue",
    title: "潮声之前",
    summary: "一切尚未被分类时，最初的记录从这里开始。",
    art: "/assets/lonely-sea/mist.png",
    x: 18,
    y: 8,
    unlocked: true,
  },
  {
    id: "arrival",
    title: "来到孤独之海",
    summary: "进入这处介于记忆与潮汐之间的个人档案。",
    art: "/assets/lonely-sea/day.png",
    x: 42,
    y: 22,
    unlocked: true,
  },
  {
    id: "about",
    title: "关于我",
    summary: "一段可以直接读取的自我介绍，也是故事的第一条公开分支。",
    art: "/assets/lonely-sea/night.png",
    x: 42,
    y: 39,
    unlocked: true,
  },
  {
    id: "archive",
    title: "文章与记录",
    summary: "从文章归档进入另一条以阅读为主的轨道。",
    art: "/assets/lonely-sea/mist.png",
    x: 68,
    y: 39,
    unlocked: true,
  },
  {
    id: "diary",
    title: "日记与月份",
    summary: "从年份和月份继续读取 NVL 形式的私人记录。",
    art: "/assets/lonely-sea/crimson.png",
    x: 68,
    y: 56,
    unlocked: true,
  },
  {
    id: "branch-a",
    title: "尚未抵达",
    summary: "这条故事分支仍然处于锁定状态。",
    art: "",
    x: 42,
    y: 72,
    unlocked: false,
  },
  {
    id: "branch-b",
    title: "尚未抵达",
    summary: "这条故事分支仍然处于锁定状态。",
    art: "",
    x: 68,
    y: 84,
    unlocked: false,
  },
  {
    id: "ending",
    title: "尚未抵达",
    summary: "结局会在完成对应内容后解锁。",
    art: "",
    x: 86,
    y: 94,
    unlocked: false,
  },
];

const initialFlowNode = flowNodes.find((node) => node.unlocked) ?? flowNodes[0];
const articleEmptySlots = Array.from({ length: LOAD_SLOT_CAPACITY }, (_, index) => index);
const saveEmptySlots = Array.from({ length: 6 - demoSaves.length }, (_, index) => index);
const lockedStorySlots = Array.from({ length: 7 }, (_, index) => index);
---

<div
  class="system-canvas load-canvas load-tracks-canvas tracks-x-canvas"
  aria-hidden="true"
  data-x-kind="articles"
  data-x-section="all"
  data-x-page-mode="articles"
>
  <div class="load-safe-frame">
    <button class="system-back" type="button" data-back>BACK</button>
    <header class="sys-heading"><h2>LOAD</h2></header>

    <nav class="tracks-x-primary" role="tablist" aria-label="可读取内容">
      <button
        type="button"
        role="tab"
        data-x-kind-tab="articles"
        aria-selected="true"
        aria-controls="tracks-x-panel-articles"
      >ARTICLES</button>
      <button
        type="button"
        role="tab"
        data-x-kind-tab="game"
        aria-selected="false"
        aria-controls="tracks-x-panel-game"
      >GAME DATA</button>
      <button
        type="button"
        role="tab"
        data-x-kind-tab="diary"
        aria-selected="false"
        aria-controls="tracks-x-panel-diary"
      >DIARY</button>
    </nav>

    <div class="tracks-x-stage">
      <aside class="tracks-x-index" aria-label="二级分类">
        <div class="tracks-x-index-stack">
          <div
            class="tracks-x-index-group"
            data-x-index-group="articles"
            role="tablist"
            aria-label="文章分类"
            aria-hidden="false"
          >
            {articleCategories.map((category, index) => (
              <button
                type="button"
                role="tab"
                data-x-filter={category.id}
                aria-selected={index === 0}
              ><span>{category.label}</span></button>
            ))}
          </div>

          <div
            class="tracks-x-index-group"
            data-x-index-group="game"
            role="tablist"
            aria-label="游戏记录分类"
            aria-hidden="true"
          >
            {gameSections.map((section) => (
              <button
                type="button"
                role="tab"
                data-x-filter={section.id}
                aria-selected={section.id === "flow"}
              ><span>{section.label}</span></button>
            ))}
          </div>

          <div
            class="tracks-x-index-group tracks-x-year-index"
            data-x-index-group="diary"
            role="tablist"
            aria-label="日记年份"
            aria-hidden="true"
          >
            {diaryYears.map((year, index) => (
              <button
                type="button"
                role="tab"
                data-x-filter={year}
                aria-selected={index === 0}
              ><span>{year}</span></button>
            ))}
          </div>
        </div>
      </aside>

      <div class="tracks-x-view" data-x-view-transition>
        <section
          class="tracks-x-panel tracks-x-articles"
          id="tracks-x-panel-articles"
          data-x-panel="articles"
          role="tabpanel"
          aria-hidden="false"
        >
          <div class="tracks-x-record-grid" data-x-article-grid>
            {records.map((record) => (
              <button
                class="tracks-x-record-slot"
                type="button"
                data-x-article-slot
                data-category={record.archiveCategory}
                data-href={record.url}
                data-cover={record.coverUrl}
                aria-label={"读取文章：" + record.title}
                style={`--record-art:url('${record.coverUrl}')`}
              >
                <span class="tracks-x-record-art" aria-hidden="true"></span>
                <span class="tracks-x-record-copy">
                  <strong>{record.title}</strong>
                  <time datetime={record.date.replaceAll(".", "-")}>{record.date}</time>
                </span>
              </button>
            ))}
            {articleEmptySlots.map(() => (
              <div class="tracks-x-record-slot is-empty" data-x-article-empty aria-hidden="true">
                <span class="tracks-x-empty-label">EMPTY</span>
              </div>
            ))}
          </div>
        </section>

        <section
          class="tracks-x-panel tracks-x-game"
          id="tracks-x-panel-game"
          data-x-panel="game"
          role="tabpanel"
          aria-hidden="true"
        >
          <div class="tracks-x-game-view tracks-x-save-view" data-x-game-view="save" aria-hidden="true">
            <div class="tracks-x-record-grid">
              {demoSaves.map((save) => (
                <button
                  class="tracks-x-record-slot"
                  type="button"
                  data-x-save-slot
                  aria-pressed="false"
                  style={`--record-art:url('${save.art}')`}
                >
                  <span class="tracks-x-record-art" aria-hidden="true"></span>
                  <span class="tracks-x-record-copy">
                    <strong>{save.title}</strong>
                    <time>{save.savedAt}</time>
                  </span>
                </button>
              ))}
              {saveEmptySlots.map(() => (
                <div class="tracks-x-record-slot is-empty" aria-label="空存档槽位">
                  <span class="tracks-x-empty-label">EMPTY DATA</span>
                </div>
              ))}
            </div>
          </div>

          <div class="tracks-x-game-view tracks-x-flow-view" data-x-game-view="flow" aria-hidden="false">
            <section class="tracks-x-flow-shell" data-x-flow-shell aria-label="故事流程图">
              <button
                class="tracks-x-flow-expand"
                type="button"
                data-x-flow-expand
                aria-label="放大流程图"
                aria-expanded="false"
              >
                <svg class="is-expand-icon" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M9 4H4v5M4 4l6 6M15 20h5v-5M20 20l-6-6"></path>
                </svg>
                <svg class="is-collapse-icon" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M10 10H5V5M5 5l6 6M14 14h5v5M19 19l-6-6"></path>
                </svg>
              </button>

              <div class="tracks-x-flow-layout">
                <div class="tracks-x-flow-viewport" data-x-flow-viewport>
                  <div class="tracks-x-flow-map">
                    <svg viewBox="0 0 1000 1000" preserveAspectRatio="none" aria-hidden="true">
                      <path d="M180 80 C180 145 420 145 420 220 L420 390"></path>
                      <path d="M420 390 C530 390 680 390 680 390 L680 560"></path>
                      <path d="M420 390 C420 525 420 590 420 720"></path>
                      <path d="M680 560 C680 680 680 725 680 840 C760 840 860 860 860 940"></path>
                      <path class="is-locked-route" d="M420 720 C520 720 585 760 680 840"></path>
                    </svg>

                    <span class="tracks-x-flow-chapter" style="--chapter-y:5%">0 / PROLOGUE</span>
                    <span class="tracks-x-flow-chapter" style="--chapter-y:34%">1 / FIRST RECORD</span>
                    <span class="tracks-x-flow-chapter" style="--chapter-y:69%">2 / BRANCH</span>

                    {flowNodes.map((node, index) => (
                      <button
                        class:list={["tracks-x-flow-node", { "is-locked": !node.unlocked }]}
                        type="button"
                        data-x-flow-node={node.unlocked ? node.id : undefined}
                        data-flow-title={node.title}
                        data-flow-summary={node.summary}
                        data-flow-art={node.art}
                        aria-label={node.unlocked ? node.title : "未解锁场景"}
                        aria-pressed={node.unlocked ? index === 0 : undefined}
                        disabled={!node.unlocked}
                        style={`--flow-x:${node.x}%;--flow-y:${node.y}%;--node-art:${node.art ? `url('${node.art}')` : "none"}`}
                      >
                        <span aria-hidden="true"></span>
                      </button>
                    ))}
                  </div>
                </div>

                <aside class="tracks-x-flow-detail" aria-live="polite">
                  <div
                    class="tracks-x-flow-detail-art"
                    data-x-flow-detail-art
                    style={`--detail-art:url('${initialFlowNode?.art}')`}
                  ></div>
                  <div class="tracks-x-flow-detail-copy">
                    <h3 data-x-flow-detail-title>{initialFlowNode?.title}</h3>
                    <p data-x-flow-detail-summary>{initialFlowNode?.summary}</p>
                  </div>
                </aside>
              </div>
            </section>
          </div>

          <div class="tracks-x-game-view tracks-x-story-view" data-x-game-view="story" aria-hidden="true">
            <div
              class="tracks-x-story-scroll"
              id="tracks-x-story-scroll"
              data-x-story-scroll
              tabindex="0"
              aria-label="可读取故事场景"
            >
              <div class="tracks-x-story-list">
                {storyScenes.map((scene) => (
                  <button
                    class="tracks-x-story-slot"
                    type="button"
                    data-x-story-slot
                    aria-pressed="false"
                    style={`--story-art:url('${scene.art}')`}
                  >
                    <span class="tracks-x-story-art" aria-hidden="true"></span>
                    <span class="tracks-x-story-copy">
                      <strong>{scene.title}</strong>
                      <span>{scene.summary}</span>
                    </span>
                  </button>
                ))}
                {lockedStorySlots.map(() => (
                  <div class="tracks-x-story-slot is-locked" aria-label="未解锁故事场景">
                    <span class="tracks-x-story-art" aria-hidden="true"></span>
                    <strong>LOCKED</strong>
                  </div>
                ))}
              </div>
            </div>
            <div
              class="tracks-x-story-rail"
              data-x-story-rail
              role="scrollbar"
              aria-controls="tracks-x-story-scroll"
              aria-orientation="vertical"
              aria-valuemin="0"
              aria-valuemax="100"
              aria-valuenow="0"
              tabindex="0"
            >
              <span data-x-story-thumb></span>
            </div>
          </div>
        </section>

        <section
          class="tracks-x-panel tracks-x-diary"
          id="tracks-x-panel-diary"
          data-x-panel="diary"
          role="tabpanel"
          aria-hidden="true"
        >
          {diaryMonths.map((entry, index) => (
            <article
              class="tracks-x-diary-month"
              data-x-diary-month={entry.id}
              data-diary-year={entry.year}
              data-diary-date={entry.dateLabel}
              data-diary-label={`${entry.month} / ${entry.year}`}
              data-diary-title={entry.title}
              data-diary-summary={entry.summary}
              data-diary-art={entry.art}
              aria-hidden={index !== 0}
            >
              <button
                class="tracks-x-diary-cover"
                type="button"
                data-x-diary-entry
                aria-label={`读取 ${entry.dateLabel} 日记`}
                aria-pressed="false"
                style={`--diary-art:url('${entry.art}')`}
              >
                <span class="tracks-x-diary-month-name">{entry.month}</span>
                <span class="tracks-x-diary-year">{entry.year}</span>
              </button>
              <div class="tracks-x-diary-copy">
                <time>{entry.dateLabel}</time>
                <h3>{entry.title}</h3>
                <p>{entry.summary}</p>
              </div>
            </article>
          ))}

          <section
            class="tracks-x-diary-reader"
            data-x-diary-reader
            aria-hidden="true"
            aria-label="日记阅读预览"
          >
            <div
              class="tracks-x-diary-reader-art"
              data-x-diary-reader-art
              style={`--diary-reader-art:url('${diaryMonths[0]?.art}')`}
              aria-hidden="true"
            ></div>
            <div class="tracks-x-diary-reader-copy">
              <time data-x-diary-reader-date>{diaryMonths[0]?.dateLabel}</time>
              <h3 data-x-diary-reader-title>{diaryMonths[0]?.title}</h3>
              <p data-x-diary-reader-summary>{diaryMonths[0]?.summary}</p>
            </div>
            <button
              class="tracks-x-diary-reader-close"
              type="button"
              data-x-diary-reader-close
            >RETURN</button>
          </section>
        </section>
      </div>
    </div>

    <div class="tracks-x-edge-turners" data-x-page-controls aria-label="内容翻页">
      <button type="button" data-x-page-direction="-1" aria-label="上一页">‹</button>
      <button type="button" data-x-page-direction="1" aria-label="下一页">›</button>
    </div>

    <nav class="tracks-x-page-nav" data-x-page-nav aria-label="当前内容页码">
      <div class="tracks-x-page-markers" data-x-page-markers></div>
      <strong data-x-page-status></strong>
    </nav>

    <div class="load-variant-switcher tracks-x-reference-switcher" aria-label="布局方案切换（临时调试）">
      <button type="button" data-load-variant-option="memory" aria-pressed="false" title="Kimi 方案一">Ⅰ</button>
      <button type="button" data-load-variant-option="list" aria-pressed="false" title="Kimi 方案二">Ⅱ</button>
      <button type="button" data-load-variant-option="editorial" aria-pressed="false" title="Kimi 方案三">Ⅲ</button>
      <button type="button" data-load-variant-option="moon" aria-pressed="false" title="月白">Ⅳ</button>
      <button type="button" data-load-variant-option="dossier" aria-pressed="false" title="残卷">Ⅴ</button>
      <button type="button" data-load-variant-option="tide" aria-pressed="false" title="潮汐">Ⅵ</button>
      <button type="button" data-load-variant-option="vnclassic" aria-pressed="false" title="传统 Galgame">Ⅶ</button>
      <button type="button" data-load-variant-option="tsukihime" aria-pressed="false" title="月姬 Remake 参考">Ⅷ</button>
      <button type="button" data-load-variant-option="cartagra" aria-pressed="false" title="恋狱月狂病 Remake 参考">Ⅸ</button>
      <button type="button" data-load-variant-option="tracks" aria-pressed="true" title="三轨记录">Ⅹ</button>
      <button type="button" data-load-variant-option="tracks-xi" aria-pressed="false" title="月潮图谱">Ⅺ</button>
      <button type="button" data-load-variant-option="tracks-xii" aria-pressed="false" title="月海存档">Ⅻ</button>
    </div>
  </div>
</div>
