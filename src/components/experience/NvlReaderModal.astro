---
import { NVL_CHAPTERS } from "../../data/nvl-chapters";
import "../../styles/nvl-player.css";

const chaptersJson = JSON.stringify(NVL_CHAPTERS).replaceAll("<", "\\u003c");
---

<div
  id="nvl-theater-modal"
  class="nvl-theater-system"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-labelledby="nvl-chapter-title"
>
  <div class="nvl-stage-backdrop" aria-hidden="true">
    <div class="nvl-stage-image" id="nvl-backdrop-image"></div>
    <div class="nvl-stage-tone" id="nvl-backdrop-tone"></div>
    <div class="nvl-stage-texture"></div>
  </div>

  <div class="nvl-entry-overlay" id="nvl-entry-overlay" aria-hidden="true">
    <span>DIARY / NVL</span>
    <strong id="nvl-entry-month">2026.04</strong>
    <i></i>
    <small>READING MEMORY</small>
  </div>

  <div class="nvl-cutscene-overlay" id="nvl-cutscene" aria-hidden="true">
    <div class="nvl-cutscene-content">
      <div class="nvl-cutscene-sub" id="nvl-cutscene-sub">ANOTHER VIEWPOINT</div>
      <div class="nvl-cutscene-main" id="nvl-cutscene-main">章节标题</div>
    </div>
  </div>

  <header class="nvl-top-bar">
    <button type="button" class="nvl-back-button" id="nvl-btn-close" aria-label="退出 NVL，返回日记月份" data-ui-sound="back">
      <span aria-hidden="true">←</span> BACK
    </button>
    <div class="nvl-scene-meta">
      <span>DIARY / NVL</span>
      <strong id="nvl-pov-title">POV: 浅仪式</strong>
      <time id="nvl-pov-time">2026-04-04 03:17:00</time>
    </div>
    <nav class="nvl-top-actions" aria-label="NVL 操作">
      <button type="button" class="nvl-action-btn" id="nvl-btn-save" data-ui-sound="confirm">SAVE</button>
      <button type="button" class="nvl-action-btn" id="nvl-btn-load" data-ui-sound="open">LOAD</button>
      <button type="button" class="nvl-action-btn" id="nvl-btn-log" data-ui-sound="open">LOG</button>
      <button type="button" class="nvl-action-btn" id="nvl-btn-auto" aria-pressed="false">AUTO</button>
    </nav>
  </header>

  <main class="nvl-content-container" id="nvl-click-target" tabindex="0" aria-label="点击继续阅读文本">
    <aside class="nvl-page-rail" aria-hidden="true">
      <span id="nvl-page-current">01</span>
      <i></i>
      <span id="nvl-page-total">01</span>
    </aside>
    <article class="nvl-page" id="nvl-page" aria-live="polite">
      <div class="nvl-text-flow" id="nvl-text-flow"></div>
    </article>
  </main>

  <footer class="nvl-bottom-bar">
    <div class="nvl-chapter-meta">
      <span id="nvl-chapter-month">2026.04</span>
      <div class="nvl-chapter-title" id="nvl-chapter-title">2026年4月 · 安娜篇</div>
    </div>
    <nav class="nvl-progress" id="nvl-progress" aria-label="已读页面"></nav>
    <div class="nvl-next-cue" id="nvl-next-cue">
      <span>CLICK / SPACE</span>
      <i class="nvl-cursor-blink" aria-hidden="true"></i>
    </div>
  </footer>

  <aside class="nvl-backlog-modal" id="nvl-backlog-modal" role="dialog" aria-modal="true" aria-labelledby="nvl-backlog-title" aria-hidden="true">
    <div class="nvl-backlog-header">
      <div>
        <span>DIARY / NVL</span>
        <h3 id="nvl-backlog-title">TEXT LOG</h3>
      </div>
      <button type="button" class="nvl-backlog-close" id="nvl-backlog-close" data-ui-sound="close"><span aria-hidden="true">×</span> CLOSE</button>
    </div>
    <div class="nvl-backlog-body" id="nvl-backlog-body"></div>
  </aside>

  <div class="nvl-save-notice" id="nvl-save-notice" role="status" aria-live="polite" aria-hidden="true">
    <span>SAVE COMPLETE</span>
    <strong id="nvl-save-notice-title">2026.04 / PAGE 01</strong>
  </div>

  <script id="nvl-chapters-data" type="application/json" set:html={chaptersJson} is:inline></script>
</div>

<script>
  import "../../scripts/experience/nvl-engine.js";
</script>
