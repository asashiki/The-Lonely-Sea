---
import { Image } from "astro:assets";
import { formatPostDate, postHref, type Post } from "../lib/posts";

interface Props {
  post: Post;
  index: number;
  featured?: boolean;
}

const { post, index, featured = false } = Astro.props;
const { data } = post;
const number = String(index + 1).padStart(2, "0");
---

<article class:list={["record-card", { "record-card--featured": featured }]}>
  <a class="record-card__link" href={postHref(post)}>
    <div class:list={["record-card__visual", { "record-card__visual--text": !data.cover }]}>
      {
        data.cover ? (
          <Image
            class="record-card__cover"
            src={data.cover}
            alt=""
            format="webp"
            quality={82}
            loading={featured ? "eager" : "lazy"}
          />
        ) : (
          <div class="text-record" aria-hidden="true">
            <span>TEXT</span>
            <strong>RECORD</strong>
            <small>NO COVER / PLAIN ARCHIVE</small>
          </div>
        )
      }
    </div>
    <div class="record-card__copy">
      <p class="record-card__meta">
        <span>{number}</span>
        <span>{data.category ?? "未分类"}</span>
        <time datetime={data.published.toISOString()}>{formatPostDate(data.published)}</time>
      </p>
      <h2>{data.title}</h2>
      <p class="record-card__description">{data.description}</p>
      <span class="record-card__enter" aria-hidden="true">ENTER&nbsp; →</span>
    </div>
  </a>
</article>

<style>
  .record-card {
    min-inline-size: 0;
    min-block-size: 0;
  }

  .record-card__link {
    position: relative;
    display: grid;
    grid-template-rows: minmax(12rem, 1fr) auto;
    block-size: 100%;
    overflow: hidden;
    border: 1px solid var(--archive-line);
    color: var(--archive-ink);
    background: var(--archive-card);
    box-shadow: 0 0.8rem 2.6rem rgb(18 28 37 / 10%);
    text-decoration: none;
    transition:
      border-color 180ms ease,
      box-shadow 260ms ease,
      translate 260ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .record-card__visual {
    position: relative;
    min-block-size: 12rem;
    overflow: hidden;
    background: #aeb7bf;
  }

  .record-card__cover {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    filter: saturate(0.7) brightness(0.91) contrast(0.94);
    transition:
      filter 260ms ease,
      scale 520ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .record-card__visual::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 48%, rgb(8 17 24 / 24%));
    content: "";
    pointer-events: none;
  }

  .record-card__visual--text {
    display: grid;
    place-items: center;
    color: rgb(39 51 63 / 76%);
    background:
      linear-gradient(90deg, rgb(45 59 72 / 8%) 1px, transparent 1px) 0 0 / 2.5rem 100%,
      linear-gradient(145deg, rgb(236 240 242 / 92%), rgb(169 181 191 / 92%));
  }

  .text-record {
    display: grid;
    justify-items: center;
    inline-size: min(78%, 19rem);
    padding-block: 2.3rem;
    border-block: 1px solid currentColor;
    text-align: center;

    span,
    small {
      font-family: var(--font-sans);
      font-size: 0.58rem;
      font-weight: 600;
      letter-spacing: 0.28em;
    }

    strong {
      margin-block: 0.25rem 0.55rem;
      font-family: var(--font-latin);
      font-size: clamp(2.25rem, 5vw, 4.5rem);
      font-weight: 400;
      letter-spacing: 0.08em;
      line-height: 0.9;
    }
  }

  .record-card__copy {
    position: relative;
    padding: clamp(1.15rem, 2.3vw, 2rem);
    border-block-start: 1px solid var(--archive-line);
  }

  .record-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 0.9rem;
    color: var(--archive-soft);
    font-family: var(--font-sans);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;

    span:first-child {
      font-family: var(--font-latin);
      font-style: italic;
    }
  }

  h2 {
    max-inline-size: 20ch;
    margin-block: 0.65rem 0;
    font-size: clamp(1.3rem, 2.3vw, 2.15rem);
    font-weight: 500;
    letter-spacing: 0.045em;
    line-height: 1.3;
    text-wrap: balance;
  }

  .record-card__description {
    max-inline-size: 38rem;
    margin-block-start: 0.65rem;
    padding-inline-end: 4rem;
    color: var(--archive-soft);
    font-family: var(--font-sans);
    font-size: 0.84rem;
    line-height: 1.75;
    text-wrap: pretty;
  }

  .record-card__enter {
    position: absolute;
    right: clamp(1rem, 2vw, 1.7rem);
    bottom: clamp(1.2rem, 2vw, 1.8rem);
    color: var(--archive-faint);
    font-family: var(--font-sans);
    font-size: 0.57rem;
    font-weight: 600;
    letter-spacing: 0.13em;
    transition:
      color 180ms ease,
      translate 220ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .record-card__link:hover {
      border-color: color-mix(in oklab, var(--archive-accent) 72%, transparent);
      box-shadow: 0 1.2rem 3.2rem rgb(18 28 37 / 18%);
      translate: 0 -0.35rem;
    }

    .record-card__link:hover .record-card__cover {
      filter: saturate(0.82) brightness(0.95) contrast(0.96);
      scale: 1.025;
    }

    .record-card__link:hover .record-card__enter {
      color: var(--archive-ink);
      translate: 0.25rem 0;
    }
  }

  .record-card__link:focus-visible {
    outline-offset: -0.3rem;
  }

  @container archive (inline-size >= 62rem) {
    .record-card--featured .record-card__link {
      grid-template-rows: 1fr;
    }

    .record-card--featured .record-card__visual,
    .record-card--featured .record-card__cover {
      position: absolute;
      inset: 0;
      inline-size: 100%;
      block-size: 100%;
    }

    .record-card--featured .record-card__visual::after {
      background: linear-gradient(180deg, transparent 28%, rgb(6 14 20 / 82%));
    }

    .record-card--featured .record-card__copy {
      align-self: end;
      margin-block-start: 18rem;
      border: 0;
      color: #f1f4f5;
      background: linear-gradient(180deg, transparent, rgb(6 14 20 / 80%) 30%);
    }

    .record-card--featured .record-card__meta,
    .record-card--featured .record-card__description,
    .record-card--featured .record-card__enter {
      color: rgb(229 237 241 / 68%);
    }

    .record-card--featured h2 {
      font-size: clamp(1.8rem, 3vw, 3rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .record-card__link,
    .record-card__cover,
    .record-card__enter {
      transition: none;
    }
  }
</style>
